"""Legacy engine access for explicit comparison and migration tests only."""

from __future__ import annotations

from typing import Any, Callable


COMPARISON_ROLLOUT_MODES = frozenset({"legacy_default", "span_shadow_compare"})


def transform_for_comparison(text: str) -> str:
    from engine.pipeline.transform_engine import normalize_text
    from engine.prosody.comma import insert_commas
    from engine.prosody.paragraph import split_paragraphs

    normalized = normalize_text(text)
    with_commas = insert_commas(normalized)
    return split_paragraphs(with_commas)


def transform_with_comparison_rollout(
    text: str,
    *,
    mode: str = "span_shadow_compare",
    include_debug: bool = False,
    legacy_transform: Callable[[str], str] | None = None,
) -> str | dict[str, Any]:
    """Run an explicitly comparison-only legacy or shadow rollout."""
    normalized_mode = normalize_comparison_mode(mode)
    if normalized_mode not in COMPARISON_ROLLOUT_MODES:
        raise ValueError(
            "comparison facade supports only legacy_default and "
            "span_shadow_compare"
        )

    result = run_comparison_rollout(
        text,
        mode=normalized_mode,
        legacy_transform=legacy_transform or transform_for_comparison,
        include_debug=include_debug,
    )
    if not result["ok"]:
        if include_debug:
            return result
        raise RuntimeError(result["error"] or "comparison transform failed")
    if include_debug:
        return result
    return result["normalized_text"]


def normalize_comparison_mode(mode: str) -> str:
    """Normalize a mode accepted only by the comparison facade."""
    if not isinstance(mode, str):
        raise TypeError("mode must be str")
    normalized = mode.strip().lower()
    if normalized not in COMPARISON_ROLLOUT_MODES:
        raise ValueError(
            "comparison facade supports only legacy_default and "
            "span_shadow_compare"
        )
    return normalized


def run_comparison_rollout(
    text: str,
    *,
    mode: str = "span_shadow_compare",
    legacy_transform: Callable[[str], str] | None = None,
    include_debug: bool = False,
) -> dict[str, Any]:
    """Return the historical rollout-shaped payload for comparison tools."""
    if not isinstance(text, str):
        raise TypeError("text must be a string")

    normalized_mode = normalize_comparison_mode(mode)
    legacy_callable = legacy_transform or transform_for_comparison
    if normalized_mode == "legacy_default":
        try:
            legacy_output = legacy_callable(text)
        except Exception as exc:
            return {
                "ok": False,
                "mode": "legacy_default",
                "input_text": text,
                "normalized_text": None,
                "production_output": None,
                "legacy_output": None,
                "span_output": None,
                "compare": None,
                "error": str(exc),
            }
        return {
            "ok": True,
            "mode": "legacy_default",
            "input_text": text,
            "normalized_text": legacy_output,
            "production_output": legacy_output,
            "legacy_output": legacy_output,
            "span_output": None,
            "compare": None,
            "error": None,
        }

    compare_result = run_shadow_compare(
        text,
        legacy_transform=legacy_callable,
        include_debug=include_debug,
    )
    return {
        "ok": compare_result["production_output"] is not None,
        "mode": "span_shadow_compare",
        "input_text": text,
        "normalized_text": compare_result["production_output"],
        "production_output": compare_result["production_output"],
        "legacy_output": compare_result["legacy_output"],
        "span_output": compare_result["span_output"],
        "compare": compare_result,
        "error": (
            compare_result["legacy_error"]
            if compare_result["production_output"] is None
            else None
        ),
    }


def run_shadow_compare(
    text: str,
    *,
    legacy_transform: Callable[[str], str] | None = None,
    include_debug: bool = False,
) -> dict[str, Any]:
    """Compare the isolated legacy result with the production span result."""
    from engine.span_engine.compare import build_span_debug, classify_compare_result
    from engine.span_engine.production_adapter import transform_for_production

    if not isinstance(text, str):
        raise TypeError("text must be a string")

    legacy_output: str | None = None
    legacy_error: str | None = None
    span_error: str | None = None
    span_debug: dict[str, Any] | None = None
    legacy_callable = legacy_transform or transform_for_comparison

    try:
        legacy_output = legacy_callable(text)
    except Exception as exc:
        legacy_error = str(exc)

    try:
        span_output = transform_for_production(text)
    except Exception as exc:
        span_output = None
        span_error = str(exc)

    if include_debug and span_error is None:
        try:
            span_debug = build_span_debug(text)
        except Exception as exc:
            span_debug = _fallback_debug(text, exc)

    compare_result = classify_compare_result(
        input_text=text,
        legacy_output=legacy_output,
        span_output=span_output,
        span_debug=span_debug,
        legacy_error=legacy_error,
        span_error=span_error,
    )
    result = compare_result.to_dict()
    result["input_text"] = text
    result["production_output"] = legacy_output if legacy_error is None else None
    result["shadow"] = True
    if include_debug and span_debug is not None:
        result["span_debug"] = span_debug
    return result


def build_shadow_compare_payload(
    payload: dict[str, Any],
    *,
    legacy_transform: Callable[[str], str] | None = None,
    include_debug: bool = False,
) -> dict[str, Any]:
    """Build a comparison-only payload without exposing it to production."""
    if not isinstance(payload, dict):
        raise TypeError("payload must be dict")
    if "text" not in payload:
        raise KeyError("text")

    text = payload["text"]
    if not isinstance(text, str):
        raise TypeError("text must be a string")

    compare_result = run_shadow_compare(
        text,
        legacy_transform=legacy_transform,
        include_debug=include_debug,
    )
    return {
        "ok": True,
        "mode": "span_shadow_compare",
        "normalized_text": compare_result["production_output"],
        "span_output": compare_result["span_output"],
        "legacy_output": compare_result["legacy_output"],
        "compare": compare_result,
    }


def _fallback_debug(text: str, exc: Exception) -> dict[str, Any]:
    return {
        "normalized_text": text,
        "fallback": "preserve_original",
        "error_type": type(exc).__name__,
        "error_message": str(exc),
        "error_stage": "transform",
    }

__all__ = [
    "COMPARISON_ROLLOUT_MODES",
    "build_shadow_compare_payload",
    "normalize_comparison_mode",
    "run_comparison_rollout",
    "run_shadow_compare",
    "transform_for_comparison",
    "transform_with_comparison_rollout",
]
