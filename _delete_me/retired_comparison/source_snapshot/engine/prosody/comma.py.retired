from __future__ import annotations

import re
from dataclasses import dataclass

from engine.pipeline.surfaces import NormalizationResult, RenderedSurfaceSpan, SurfaceType
from engine.tokenizer import token_types
from engine.tokenizer.tokenizer import Token, tokenize


LEADING_CONNECTOR = "LEADING_CONNECTOR"
LEADING_TIME_FRAME = "LEADING_TIME_FRAME"
MARKED_SUBORDINATE_CLAUSE_END = "MARKED_SUBORDINATE_CLAUSE_END"
SERIAL_PARALLEL_3PLUS = "SERIAL_PARALLEL_3PLUS"
LONG_TOPIC_WITH_EXPLICIT_SHIFT = "LONG_TOPIC_WITH_EXPLICIT_SHIFT"

_STRONG_CONNECTORS = {
    "그리고",
    "하지만",
    "그러나",
    "그래서",
    "또한",
    "다만",
    "즉",
    "반면",
    "대신",
    "한편",
    "따라서",
}
_TOPIC_JOSA = ("은", "는", "이", "가")
_FRAME_JOSA = ("에", "에서", "에게", "한테", "부터", "까지", "으로", "로")
_DEPENDENT_NOUNS = {"것", "수", "점", "바"}
_DIRECTIVES = ("이", "그", "저", "해당")
_TIME_WORDS = {
    "오늘",
    "내일",
    "어제",
    "모레",
    "아침",
    "오전",
    "오후",
    "저녁",
    "밤",
    "이번",
    "이후",
    "이전",
    "직후",
    "직전",
    "당장",
    "앞으로",
}
_EXPLICIT_SHIFT_WORDS = {"이번", "이후", "이전", "당장", "앞으로", "다음", "현재"}
_EVENT_KEYWORDS = {
    "사태",
    "혁명",
    "전쟁",
    "사건",
    "사고",
    "기념일",
    "선거",
    "민주화운동",
}

_KO_NUMBER_WORD_RE = re.compile(
    r"^[영공일이삼사오육칠팔구십백천만억조경한두세네다섯여섯일곱여덟아홉열스물서른마흔쉰예순일흔여든아흔]+$"
)
_TIME_SURFACE_RE = re.compile(
    r"^(?:"
    r"(?:오늘|내일|어제|모레|아침|오전|오후|저녁|밤)"
    r"|(?:이번|다음)\s*분기"
    r"|(?:올해|금년|내년|작년)"
    r"|[영공일이삼사오육칠팔구십백천만억조경한두세네다섯여섯일곱여덟아홉열스물서른마흔쉰예순일흔여든아흔]+(?:년|월|일|시|분|초)"
    r")(?:은|는|에|부터|까지)?$"
)
_ATOMIC_TIME_SURFACE_RE = re.compile(
    r"^[영공일이삼사오육칠팔구십백천만억조경한두세네다섯여섯일곱여덟아홉열스물서른마흔쉰예순일흔여든아흔]+(?:년|월|일|시|분|초)(?:은|는|에|부터|까지)?$"
)
_NUMERIC_UNIT_RE = re.compile(
    r"^(?:"
    r"\d+(?:[.:/-]\d+)*"
    r"|[영공일이삼사오육칠팔구십백천만억조경한두세네다섯여섯일곱여덟아홉열스물서른마흔쉰예순일흔여든아흔]+"
    r")(?:개|명|원|전|배|건|층|번|호|퍼센트|킬로그램|그램|미터|리터|달러|유로|엔|파운드|위안|도|시|분|초|년|월|일|개월)(?:은|는|이|가|을|를|에|에서|에게|부터|까지|으로|로|도|만)?$"
)
_EMERGENCY_SURFACE_RE = re.compile(r"^일일(?:이|구)(?:은|는|이|가|을|를|에|에서|에게|로|으로|도|만)?$")
_IP_RE = re.compile(r"^(?:\d{1,3}\.){3}\d{1,3}$")
_URL_RE = re.compile(r"^(?:https?://|www\.)")
_PATH_RE = re.compile(r"^(?:[A-Za-z]:[/\\]|[/\\]).+")
_CODE_LIKE_RE = re.compile(r"^(?:[A-Za-z]+-\d+(?:-\d+)*[가-힣]*|D-\d+)$")
_NUMBERISH_RE = re.compile(r"\d")

_SURFACE_TYPE_TO_PROTECTED_KIND = {
    SurfaceType.ACRONYM_SURFACE: "ACRONYM",
    SurfaceType.ALLOWED_ACRONYM_WITH_PARTICLE: "ACRONYM",
    SurfaceType.ACRONYM_WITH_LEXICAL_SUFFIX_SURFACE: "ACRONYM",
    SurfaceType.LEXICAL_MIDDLEDOT_SURFACE: "LEXICAL_MIDDOT",
    SurfaceType.SINGLE_LETTER_HYPHEN_SURFACE: "SINGLE_LETTER_HYPHEN",
    SurfaceType.NUMERIC_PREFIXED_NOUN_SURFACE: "NUMERIC_UNIT",
    SurfaceType.NUMERIC_UNIT_SURFACE: "NUMERIC_UNIT",
    SurfaceType.NUMERIC_CURRENCY_SURFACE: "NUMERIC_UNIT",
    SurfaceType.COUNTER_SURFACE: "NUMERIC_UNIT",
    SurfaceType.RANGE_SURFACE: "RANGE",
    SurfaceType.RANGE_WITH_UNIT_SURFACE: "RANGE",
    SurfaceType.LARGE_UNIT_ATOMIC_SURFACE: "LARGE_UNIT",
    SurfaceType.SIGNED_DEGREE_SURFACE: "SIGNED_DEGREE",
    SurfaceType.EVENT_SURFACE: "EVENT",
    SurfaceType.PROTECTED_LITERAL_SURFACE: "OTHER",
}

_BOUNDARY_BASE_SCORES = {
    LEADING_CONNECTOR: 1.0,
    MARKED_SUBORDINATE_CLAUSE_END: 0.9,
    SERIAL_PARALLEL_3PLUS: 0.8,
    LEADING_TIME_FRAME: 0.7,
    LONG_TOPIC_WITH_EXPLICIT_SHIFT: 0.5,
}

_NUMERIC_UNIT_TAIL_PREFIXES = (
    "개",
    "명",
    "원",
    "전",
    "배",
    "건",
    "층",
    "번",
    "호",
    "킬로그램",
    "그램",
    "미터",
    "리터",
    "달러",
    "유로",
    "엔",
    "파운드",
    "도",
    "시",
    "분",
    "초",
    "년",
    "월",
    "일",
    "개월",
)
_FRAME_WORDS = {"분기", "단계", "현장"}
_BOUNDARY_PUNCTUATION = tuple(",.;:!?")
_EVENT_NUMBER_RE = re.compile(r"^\d+(?:\.\d+)?$")
_WHITESPACE_RE = re.compile(r"\s+")


@dataclass(frozen=True, slots=True)
class Eojeol:
    text: str
    start: int
    end: int


@dataclass(frozen=True, slots=True)
class EojeolFeatures:
    normalized: str
    char_len: int
    is_number_word: bool
    is_atomic_time: bool
    is_numeric_unit: bool
    is_emergency: bool
    is_ip: bool
    is_url: bool
    is_path: bool
    is_code: bool
    is_event_number: bool
    is_numeric_like: bool
    is_time_surface: bool
    is_frame: bool
    is_time_or_frame: bool
    is_topic: bool
    is_predicate: bool
    is_numeric_unit_tail: bool
    starts_path_like: bool
    continues_path_like: bool
    is_middle_dot_member: bool
    protected_kind: str | None


@dataclass(frozen=True, slots=True)
class ProtectedSpan:
    start: int
    end: int
    kind: str


@dataclass(frozen=True, slots=True)
class BoundaryCandidate:
    kind: str
    left_index: int
    right_index: int
    score: float


@dataclass(frozen=True, slots=True)
class SentenceContext:
    text: str
    tokens: tuple[Token, ...]
    eojeols: tuple[Eojeol, ...]
    eojeol_features: tuple[EojeolFeatures, ...]
    protected_spans: tuple[ProtectedSpan, ...]
    protected_indices: frozenset[int]
    numeric_like_indices: frozenset[int]
    eojeol_char_prefix: tuple[int, ...]
    boundary_has_whitespace: tuple[bool, ...]
    boundary_crosses_protected: tuple[bool, ...]
    boundary_touches_protected: tuple[bool, ...]
    boundary_punctuation_conflict: tuple[bool, ...]
    predicate_after: tuple[bool, ...]
    numeric_or_protected_prefix: tuple[int, ...]
    numeric_or_protected_count: int
    has_strong_connector: bool
    char_len: int
    existing_comma_count: int
    existing_strong_punct_count: int
    numeric_like_ratio: float
    protected_coverage: float


def insert_commas(text: str | NormalizationResult) -> str:
    if isinstance(text, NormalizationResult):
        if not text.text or not text.text.strip():
            return text.text
        return "".join(
            _insert_commas_in_sentence(sentence, _project_surface_spans(text.rendered_surfaces, start, end))
            for sentence, start, end in _split_sentences_with_offsets(text.text)
        )

    if not text or not text.strip():
        return text

    return "".join(_insert_commas_in_sentence(sentence) for sentence in _split_sentences(text))


def _split_sentences(text: str) -> list[str]:
    return [sentence for sentence, _, _ in _split_sentences_with_offsets(text)]


def _split_sentences_with_offsets(text: str) -> list[tuple[str, int, int]]:
    parts: list[str] = []
    start = 0
    i = 0
    slices: list[tuple[str, int, int]] = []

    while i < len(text):
        char = text[i]
        if char == "\n":
            sentence = text[start : i + 1]
            parts.append(sentence)
            slices.append((sentence, start, i + 1))
            start = i + 1
            i += 1
            continue

        if char not in ".?!":
            i += 1
            continue

        prev_char = text[i - 1] if i > 0 else ""
        next_char = text[i + 1] if i + 1 < len(text) else ""
        if prev_char.isdigit() and next_char.isdigit():
            i += 1
            continue
        if prev_char.isalpha() and next_char.isalpha():
            i += 1
            continue

        end = i + 1
        while end < len(text) and text[end].isspace() and text[end] != "\n":
            end += 1
        sentence = text[start:end]
        parts.append(sentence)
        slices.append((sentence, start, end))
        start = end
        i = end

    if start < len(text):
        sentence = text[start:]
        parts.append(sentence)
        slices.append((sentence, start, len(text)))

    return slices


def _insert_commas_in_sentence(
    sentence: str,
    surface_spans: tuple[RenderedSurfaceSpan, ...] = (),
) -> str:
    leading_ws_len = len(sentence) - len(sentence.lstrip())
    leading_ws = sentence[:leading_ws_len]
    body = sentence[leading_ws_len:]

    trailing_ws = ""
    while body and body[-1].isspace() and body[-1] != "\n":
        trailing_ws = body[-1] + trailing_ws
        body = body[:-1]

    trailing_marks = ""
    while body and body[-1] in ".?!\n":
        trailing_marks = body[-1] + trailing_marks
        body = body[:-1]

    if not body.strip():
        return sentence

    ctx = _build_sentence_context(body, surface_spans)
    if _is_hard_blocked(ctx):
        return leading_ws + body + trailing_marks + trailing_ws

    candidates = _detect_typed_boundaries(ctx)
    if not candidates:
        return leading_ws + body + trailing_marks + trailing_ws

    budget = _boundary_budget(ctx, candidates)
    if budget <= 0:
        return leading_ws + body + trailing_marks + trailing_ws

    selected = _select_boundaries(candidates, budget)
    if not selected:
        return leading_ws + body + trailing_marks + trailing_ws

    rendered = _render_boundaries(ctx.tokens, ctx.eojeols, selected)
    return leading_ws + rendered + trailing_marks + trailing_ws


def _build_sentence_context(
    text: str,
    surface_spans: tuple[RenderedSurfaceSpan, ...] = (),
) -> SentenceContext:
    tokens = tuple(tokenize(text))
    eojeols = tuple(_extract_eojeols(tokens))
    eojeol_features = tuple(_analyze_eojeol(eojeol.text) for eojeol in eojeols)
    protected_spans = tuple(_detect_protected_spans(eojeols, eojeol_features, surface_spans))
    protected_indices = _build_protected_indices(protected_spans)
    numeric_like_indices = frozenset(
        idx for idx, feature in enumerate(eojeol_features) if feature.is_numeric_like
    )
    eojeol_char_prefix = _build_eojeol_char_prefix(eojeol_features)
    char_len = eojeol_char_prefix[-1]
    boundary_has_whitespace = _build_boundary_has_whitespace(text, eojeols)
    boundary_crosses_protected = _build_boundary_crosses_protected(
        len(eojeols), protected_spans
    )
    boundary_touches_protected = _build_boundary_touches_protected(
        len(eojeols), protected_indices
    )
    boundary_punctuation_conflict = _build_boundary_punctuation_conflict(text, eojeols)
    predicate_after = _build_predicate_after(eojeol_features)
    numeric_or_protected_prefix = _build_numeric_or_protected_prefix(
        eojeol_features, protected_indices
    )
    numeric_or_protected_count = numeric_or_protected_prefix[-1]
    numeric_like_ratio = (
        len(numeric_like_indices) / len(eojeols) if eojeols else 0.0
    )
    protected_coverage = _protected_coverage(text, eojeols, protected_spans, char_len)
    return SentenceContext(
        text=text,
        tokens=tokens,
        eojeols=eojeols,
        eojeol_features=eojeol_features,
        protected_spans=protected_spans,
        protected_indices=protected_indices,
        numeric_like_indices=numeric_like_indices,
        eojeol_char_prefix=eojeol_char_prefix,
        boundary_has_whitespace=boundary_has_whitespace,
        boundary_crosses_protected=boundary_crosses_protected,
        boundary_touches_protected=boundary_touches_protected,
        boundary_punctuation_conflict=boundary_punctuation_conflict,
        predicate_after=predicate_after,
        numeric_or_protected_prefix=numeric_or_protected_prefix,
        numeric_or_protected_count=numeric_or_protected_count,
        has_strong_connector=any(
            eojeol.text in _STRONG_CONNECTORS for eojeol in eojeols
        ),
        char_len=char_len,
        existing_comma_count=text.count(","),
        existing_strong_punct_count=sum(text.count(ch) for ch in ";:"),
        numeric_like_ratio=numeric_like_ratio,
        protected_coverage=protected_coverage,
    )


def _extract_eojeols(tokens: tuple[Token, ...]) -> list[Eojeol]:
    eojeols: list[Eojeol] = []
    current_parts: list[str] = []
    current_start: int | None = None
    current_end: int | None = None

    for token in tokens:
        if token.kind in {token_types.SPACE, token_types.NEWLINE}:
            if current_parts and current_start is not None and current_end is not None:
                eojeols.append(
                    Eojeol(
                        text="".join(current_parts),
                        start=current_start,
                        end=current_end,
                    )
                )
                current_parts = []
                current_start = None
                current_end = None
            continue

        if current_start is None:
            current_start = token.start
        current_end = token.end
        current_parts.append(token.text)

    if current_parts and current_start is not None and current_end is not None:
        eojeols.append(Eojeol(text="".join(current_parts), start=current_start, end=current_end))

    return eojeols


def _detect_protected_spans(
    eojeols: tuple[Eojeol, ...],
    eojeol_features: tuple[EojeolFeatures, ...],
    surface_spans: tuple[RenderedSurfaceSpan, ...] = (),
) -> list[ProtectedSpan]:
    spans: list[ProtectedSpan] = _project_surface_protected_spans(eojeols, surface_spans)
    i = 0

    while i < len(eojeols):
        feature = eojeol_features[i]

        if feature.starts_path_like:
            end = i + 1
            while end < len(eojeols) and eojeol_features[end].continues_path_like:
                end += 1
            spans.append(ProtectedSpan(i, end, "PATH"))
            i = end
            continue

        if (
            i + 2 < len(eojeols)
            and eojeols[i + 1].text == "·"
            and feature.is_middle_dot_member
            and eojeol_features[i + 2].is_middle_dot_member
        ):
            spans.append(ProtectedSpan(i, i + 3, "MIDDLE_DOT"))
            i += 3
            continue

        event_end = _detect_event_span_end(eojeol_features, i)
        if event_end is not None:
            spans.append(ProtectedSpan(i, event_end, "EVENT"))
            i = event_end
            continue

        if (
            i + 1 < len(eojeols)
            and feature.is_number_word
            and eojeol_features[i + 1].is_numeric_unit_tail
        ):
            spans.append(ProtectedSpan(i, i + 2, "NUMERIC_UNIT"))
            i += 2
            continue

        if feature.protected_kind is not None:
            spans.append(ProtectedSpan(i, i + 1, feature.protected_kind))
            i += 1
            continue

        i += 1

    return _merge_spans(spans)


def _project_surface_spans(
    spans: tuple[RenderedSurfaceSpan, ...],
    sentence_start: int,
    sentence_end: int,
) -> tuple[RenderedSurfaceSpan, ...]:
    projected: list[RenderedSurfaceSpan] = []
    for span in spans:
        if span.end <= sentence_start or span.start >= sentence_end:
            continue
        start = max(span.start, sentence_start) - sentence_start
        end = min(span.end, sentence_end) - sentence_start
        projected.append(RenderedSurfaceSpan(start, end, span.surface))
    return tuple(projected)


def _project_surface_protected_spans(
    eojeols: tuple[Eojeol, ...],
    surface_spans: tuple[RenderedSurfaceSpan, ...],
) -> list[ProtectedSpan]:
    spans: list[ProtectedSpan] = []
    if not eojeols:
        return spans

    for surface_span in surface_spans:
        if surface_span.surface.allow_prosody_inside:
            continue
        covered = [
            index
            for index, eojeol in enumerate(eojeols)
            if not (eojeol.end <= surface_span.start or eojeol.start >= surface_span.end)
        ]
        if not covered:
            continue
        kind = _SURFACE_TYPE_TO_PROTECTED_KIND.get(surface_span.surface.surface_type, "OTHER")
        spans.append(ProtectedSpan(covered[0], covered[-1] + 1, kind))
    return spans


def _detect_event_span_end(
    eojeol_features: tuple[EojeolFeatures, ...], index: int
) -> int | None:
    if index + 1 >= len(eojeol_features):
        return None

    second = eojeol_features[index + 1].normalized
    if not eojeol_features[index].is_event_number:
        return None
    if second in _EVENT_KEYWORDS:
        return index + 2
    if (
        second == "민주화"
        and index + 2 < len(eojeol_features)
        and eojeol_features[index + 2].normalized == "운동"
    ):
        return index + 3
    return None


def _merge_spans(spans: list[ProtectedSpan]) -> list[ProtectedSpan]:
    if not spans:
        return []

    ordered = sorted(spans, key=lambda span: (span.start, span.end))
    merged: list[ProtectedSpan] = [ordered[0]]

    for span in ordered[1:]:
        prev = merged[-1]
        if span.start <= prev.end:
            merged[-1] = ProtectedSpan(prev.start, max(prev.end, span.end), prev.kind)
            continue
        merged.append(span)

    return merged


def _detect_typed_boundaries(ctx: SentenceContext) -> list[BoundaryCandidate]:
    proposals: list[tuple[str, int, int]] = []

    connector = _detect_leading_connector(ctx)
    if connector is not None:
        proposals.append(connector)

    time_frame = _detect_leading_time_frame(ctx)
    if time_frame is not None:
        proposals.append(time_frame)

    proposals.extend(_detect_marked_subordinate_boundaries(ctx))

    parallel = _detect_serial_parallel(ctx)
    if parallel is not None:
        proposals.append(parallel)

    topic = _detect_long_topic_shift(ctx)
    if topic is not None:
        proposals.append(topic)

    candidates: list[BoundaryCandidate] = []
    seen: set[tuple[str, int, int]] = set()

    for kind, left_index, right_index in proposals:
        key = (kind, left_index, right_index)
        if key in seen:
            continue
        seen.add(key)
        if not _validate_boundary(ctx, kind, left_index, right_index):
            continue
        score = _score_boundary(ctx, kind, left_index, right_index)
        if score < 0.6:
            continue
        candidates.append(
            BoundaryCandidate(
                kind=kind,
                left_index=left_index,
                right_index=right_index,
                score=score,
            )
        )

    return candidates


def _detect_leading_connector(ctx: SentenceContext) -> tuple[str, int, int] | None:
    if len(ctx.eojeols) < 2:
        return None
    if ctx.eojeols[0].text not in _STRONG_CONNECTORS:
        return None
    if not _has_predicate_after(ctx, 0):
        return None
    return (LEADING_CONNECTOR, 0, 1)


def _detect_leading_time_frame(ctx: SentenceContext) -> tuple[str, int, int] | None:
    if len(ctx.eojeols) < 3:
        return None
    if ctx.eojeols[0].text in _STRONG_CONNECTORS:
        return None

    last_index: int | None = None
    if ctx.eojeol_features[0].is_time_or_frame:
        last_index = 0
        if len(ctx.eojeols) > 1 and ctx.eojeol_features[1].is_time_or_frame:
            last_index = 1
    if last_index is None:
        return None
    if (
        last_index == 0
        and last_index + 1 < len(ctx.eojeols)
        and ctx.eojeol_features[last_index + 1].is_topic
    ):
        return None
    if not _has_predicate_after(ctx, last_index):
        return None
    return (LEADING_TIME_FRAME, last_index, last_index + 1)


def _detect_marked_subordinate_boundaries(ctx: SentenceContext) -> list[tuple[str, int, int]]:
    boundaries: list[tuple[str, int, int]] = []

    for index, eojeol in enumerate(ctx.eojeols[:-1]):
        if not _has_predicate_after(ctx, index):
            continue
        if _is_marked_subordinate_end(ctx, index):
            boundaries.append((MARKED_SUBORDINATE_CLAUSE_END, index, index + 1))

    return boundaries


def _is_marked_subordinate_end(ctx: SentenceContext, index: int) -> bool:
    text = ctx.eojeols[index].text
    prev_text = ctx.eojeols[index - 1].text if index > 0 else ""

    if text.endswith(("지만", "으나", "면서", "하며")):
        return index >= 1
    if text == "나서" and prev_text.endswith("고"):
        return True
    if text == "뒤" and prev_text.endswith(("한", "는", "던", "친", "낸")):
        return True
    if text == "경우" and prev_text.endswith(("하는", "한", "할")):
        return True
    return False


def _detect_serial_parallel(ctx: SentenceContext) -> tuple[str, int, int] | None:
    connector_index = next(
        (idx for idx, eojeol in enumerate(ctx.eojeols) if eojeol.text == "그리고"),
        None,
    )
    if connector_index is None or connector_index < 3 or connector_index >= len(ctx.eojeols) - 1:
        return None
    if not _has_predicate_after(ctx, connector_index):
        return None

    if connector_index < 3:
        return None
    if not all(
        _is_natural_parallel_item_normalized(feature.normalized)
        for feature in ctx.eojeol_features[:connector_index]
    ):
        return None

    return (SERIAL_PARALLEL_3PLUS, connector_index - 1, connector_index)


def _detect_long_topic_shift(ctx: SentenceContext) -> tuple[str, int, int] | None:
    topic_index = next(
        (
            idx
            for idx, feature in enumerate(ctx.eojeol_features[:4])
            if feature.is_topic
        ),
        None,
    )
    if topic_index is None or topic_index < 2 or topic_index >= len(ctx.eojeols) - 1:
        return None

    if ctx.numeric_or_protected_prefix[topic_index + 1] > 0:
        return None
    if ctx.eojeol_char_prefix[topic_index + 1] < 8:
        return None
    if not _has_explicit_shift_after(ctx, topic_index):
        return None
    if not _has_predicate_after(ctx, topic_index):
        return None

    return (LONG_TOPIC_WITH_EXPLICIT_SHIFT, topic_index, topic_index + 1)


def _validate_boundary(
    ctx: SentenceContext,
    kind: str,
    left_index: int,
    right_index: int,
) -> bool:
    if left_index < 0 or right_index >= len(ctx.eojeols) or right_index != left_index + 1:
        return False
    if not _has_whitespace_boundary(ctx, left_index, right_index):
        return False
    if _crosses_protected_span(ctx, left_index, right_index):
        return False
    if _has_punctuation_conflict(ctx, left_index, right_index):
        return False
    if _is_too_short_boundary(ctx, left_index, right_index):
        return False
    if kind != LEADING_CONNECTOR and _touches_protected_edge(ctx, left_index, right_index):
        return False
    if _breaks_binary_phrase(ctx, kind, left_index, right_index):
        return False

    if ctx.eojeol_features[right_index].normalized in _DIRECTIVES:
        return False
    if ctx.eojeol_features[left_index].normalized in _DEPENDENT_NOUNS:
        return False

    return True


def _score_boundary(
    ctx: SentenceContext,
    kind: str,
    left_index: int,
    right_index: int,
) -> float:
    score = _BOUNDARY_BASE_SCORES[kind]

    if ctx.numeric_like_ratio >= 0.35:
        score -= 0.4
    if ctx.existing_comma_count >= 1:
        score -= 0.2
    if kind != LEADING_CONNECTOR and _touches_protected_edge(ctx, left_index, right_index):
        score -= 0.3
    if _right_chunk_short(ctx, right_index):
        score -= 0.2
    if kind == LONG_TOPIC_WITH_EXPLICIT_SHIFT and not _touches_protected_edge(ctx, left_index, right_index):
        score += 0.2

    return score


def _boundary_budget(ctx: SentenceContext, candidates: list[BoundaryCandidate]) -> int:
    if len(ctx.eojeols) < 3 or ctx.char_len < 12:
        return 1 if any(candidate.kind == LEADING_CONNECTOR for candidate in candidates) else 0

    if ctx.numeric_like_ratio >= 0.35 or ctx.protected_coverage >= 0.5:
        return (
            1
            if any(
                candidate.kind in {LEADING_CONNECTOR, MARKED_SUBORDINATE_CLAUSE_END}
                and candidate.score >= 0.6
                for candidate in candidates
            )
            else 0
        )

    if ctx.char_len >= 28 and any(candidate.score >= 0.9 for candidate in candidates):
        return 2

    return 1


def _select_boundaries(candidates: list[BoundaryCandidate], budget: int) -> list[BoundaryCandidate]:
    ordered = sorted(candidates, key=lambda candidate: (-candidate.score, candidate.left_index))
    selected: list[BoundaryCandidate] = []
    used_left_indices: set[int] = set()

    for candidate in ordered:
        if len(selected) >= budget:
            break
        if candidate.left_index in used_left_indices:
            continue
        if selected and abs(candidate.left_index - selected[-1].left_index) < 2:
            continue
        selected.append(candidate)
        used_left_indices.add(candidate.left_index)

    return sorted(selected, key=lambda candidate: candidate.left_index)


def _render_boundaries(
    tokens: tuple[Token, ...],
    eojeols: tuple[Eojeol, ...],
    boundaries: list[BoundaryCandidate],
) -> str:
    insert_positions = {eojeols[candidate.left_index].end for candidate in boundaries}
    rendered: list[str] = []

    for token in tokens:
        rendered.append(token.text)
        if token.end in insert_positions:
            rendered.append(",")
    return "".join(rendered)


def _is_hard_blocked(ctx: SentenceContext) -> bool:
    if len(ctx.eojeols) < 3 or ctx.char_len < 12:
        return not (
            ctx.eojeols
            and ctx.eojeols[0].text in _STRONG_CONNECTORS
            and _has_predicate_after(ctx, 0)
        )
    if ctx.existing_comma_count > 0 or ctx.existing_strong_punct_count > 0:
        return True
    if _is_risky_list_like_sentence(ctx):
        return True
    return False


def _is_risky_list_like_sentence(ctx: SentenceContext) -> bool:
    if len(ctx.eojeols) < 4:
        return False
    return ctx.numeric_or_protected_count >= 3 and not ctx.has_strong_connector


def _analyze_eojeol(text: str) -> EojeolFeatures:
    normalized = _normalize_surface(text)
    char_len = len(normalized)
    is_number_word = _is_number_word_normalized(normalized)
    is_atomic_time = _is_atomic_time_surface_normalized(normalized)
    is_numeric_unit = _is_numeric_unit_surface_normalized(normalized)
    is_emergency = bool(_EMERGENCY_SURFACE_RE.fullmatch(normalized))
    has_path_separator = "/" in normalized or "\\" in normalized
    is_url = bool(_URL_RE.match(normalized))
    is_path = bool(_PATH_RE.match(normalized))
    starts_path_like = is_url or is_path or has_path_separator
    continues_path_like = has_path_separator
    is_time_word = normalized in _TIME_WORDS
    is_time_surface = is_time_word or bool(_TIME_SURFACE_RE.fullmatch(normalized))
    is_frame = _is_frame_eojeol_normalized(normalized)
    is_ip = False
    is_code = False
    protected_kind: str | None = None
    if is_atomic_time:
        protected_kind = "TIME"
    elif is_numeric_unit:
        protected_kind = "NUMERIC_UNIT"
    elif is_emergency:
        protected_kind = "EMERGENCY"
    elif "." in normalized:
        is_ip = bool(_IP_RE.fullmatch(normalized))
        if is_ip:
            protected_kind = "IP"
    if protected_kind is None and is_url:
        protected_kind = "URL"
    if protected_kind is None and is_path:
        protected_kind = "PATH"
    if protected_kind is None and "-" in normalized:
        is_code = bool(_CODE_LIKE_RE.fullmatch(normalized))
        if is_code:
            protected_kind = "CODE"
    return EojeolFeatures(
        normalized=normalized,
        char_len=char_len,
        is_number_word=is_number_word,
        is_atomic_time=is_atomic_time,
        is_numeric_unit=is_numeric_unit,
        is_emergency=is_emergency,
        is_ip=is_ip,
        is_url=is_url,
        is_path=is_path,
        is_code=is_code,
        is_event_number=is_number_word or bool(_EVENT_NUMBER_RE.fullmatch(normalized)),
        is_numeric_like=_is_numeric_like_normalized(normalized),
        is_time_surface=is_time_surface,
        is_frame=is_frame,
        is_time_or_frame=is_time_surface or is_frame,
        is_topic=normalized.endswith(_TOPIC_JOSA),
        is_predicate=_is_predicate_eojeol_normalized(normalized),
        is_numeric_unit_tail=normalized.startswith(_NUMERIC_UNIT_TAIL_PREFIXES),
        starts_path_like=starts_path_like,
        continues_path_like=continues_path_like,
        is_middle_dot_member=bool(normalized)
        and any(ch.isalnum() or _is_hangul(ch) for ch in normalized),
        protected_kind=protected_kind,
    )


def _build_protected_indices(spans: tuple[ProtectedSpan, ...]) -> frozenset[int]:
    return frozenset(idx for span in spans for idx in range(span.start, span.end))


def _build_eojeol_char_prefix(
    eojeol_features: tuple[EojeolFeatures, ...],
) -> tuple[int, ...]:
    prefix = [0]
    running = 0
    for feature in eojeol_features:
        running += feature.char_len
        prefix.append(running)
    return tuple(prefix)


def _build_boundary_has_whitespace(
    text: str, eojeols: tuple[Eojeol, ...]
) -> tuple[bool, ...]:
    return tuple(
        bool(text[left.end:right.start].isspace())
        for left, right in zip(eojeols, eojeols[1:])
    )


def _build_boundary_crosses_protected(
    eojeol_count: int, spans: tuple[ProtectedSpan, ...]
) -> tuple[bool, ...]:
    boundary_flags = [False] * max(eojeol_count - 1, 0)
    for span in spans:
        for boundary_index in range(span.start, span.end - 1):
            boundary_flags[boundary_index] = True
    return tuple(boundary_flags)


def _build_boundary_touches_protected(
    eojeol_count: int, protected_indices: frozenset[int]
) -> tuple[bool, ...]:
    return tuple(
        boundary_index in protected_indices or (boundary_index + 1) in protected_indices
        for boundary_index in range(max(eojeol_count - 1, 0))
    )


def _build_boundary_punctuation_conflict(
    text: str, eojeols: tuple[Eojeol, ...]
) -> tuple[bool, ...]:
    conflicts: list[bool] = []
    for left, right in zip(eojeols, eojeols[1:]):
        between = text[left.end:right.start]
        conflicts.append(
            "," in between
            or left.text.endswith(_BOUNDARY_PUNCTUATION)
            or right.text.startswith(_BOUNDARY_PUNCTUATION)
        )
    return tuple(conflicts)


def _build_predicate_after(
    eojeol_features: tuple[EojeolFeatures, ...]
) -> tuple[bool, ...]:
    predicate_after = [False] * len(eojeol_features)
    seen_predicate = False
    for index in range(len(eojeol_features) - 1, -1, -1):
        predicate_after[index] = seen_predicate
        if eojeol_features[index].is_predicate:
            seen_predicate = True
    return tuple(predicate_after)


def _build_numeric_or_protected_prefix(
    eojeol_features: tuple[EojeolFeatures, ...],
    protected_indices: frozenset[int],
) -> tuple[int, ...]:
    prefix = [0]
    running = 0
    for index, feature in enumerate(eojeol_features):
        if feature.is_numeric_like or index in protected_indices:
            running += 1
        prefix.append(running)
    return tuple(prefix)


def _protected_coverage(
    text: str,
    eojeols: tuple[Eojeol, ...],
    spans: tuple[ProtectedSpan, ...],
    char_len: int,
) -> float:
    if char_len == 0 or not spans or not eojeols:
        return 0.0

    covered = 0
    ranges: list[tuple[int, int]] = []
    for span in spans:
        start = eojeols[span.start].start
        end = eojeols[span.end - 1].end
        ranges.append((start, end))

    ranges.sort()
    current_start, current_end = ranges[0]
    for start, end in ranges[1:]:
        if start <= current_end:
            current_end = max(current_end, end)
            continue
        covered += _char_len_no_space(text[current_start:current_end])
        current_start, current_end = start, end
    covered += _char_len_no_space(text[current_start:current_end])

    return covered / char_len


def _has_predicate_after(ctx: SentenceContext, index: int) -> bool:
    if index < 0 or index >= len(ctx.predicate_after):
        return False
    return ctx.predicate_after[index]


def _has_explicit_shift_after(ctx: SentenceContext, topic_index: int) -> bool:
    right_index = topic_index + 1
    if right_index >= len(ctx.eojeols):
        return False

    first = ctx.eojeol_features[right_index]
    if first.normalized in _EXPLICIT_SHIFT_WORDS:
        return True
    if first.is_time_or_frame:
        return True
    if (
        first.normalized in _TIME_WORDS
        and right_index + 1 < len(ctx.eojeols)
        and ctx.eojeol_features[right_index + 1].is_frame
    ):
        return True
    return False


def _has_whitespace_boundary(ctx: SentenceContext, left_index: int, right_index: int) -> bool:
    if right_index != left_index + 1 or left_index < 0 or left_index >= len(ctx.boundary_has_whitespace):
        return False
    return ctx.boundary_has_whitespace[left_index]


def _crosses_protected_span(ctx: SentenceContext, left_index: int, right_index: int) -> bool:
    if right_index != left_index + 1 or left_index < 0 or left_index >= len(ctx.boundary_crosses_protected):
        return False
    return ctx.boundary_crosses_protected[left_index]


def _touches_protected_edge(ctx: SentenceContext, left_index: int, right_index: int) -> bool:
    if right_index != left_index + 1 or left_index < 0 or left_index >= len(ctx.boundary_touches_protected):
        return False
    return ctx.boundary_touches_protected[left_index]


def _has_punctuation_conflict(ctx: SentenceContext, left_index: int, right_index: int) -> bool:
    if right_index != left_index + 1 or left_index < 0 or left_index >= len(ctx.boundary_punctuation_conflict):
        return False
    return ctx.boundary_punctuation_conflict[left_index]


def _is_too_short_boundary(ctx: SentenceContext, left_index: int, right_index: int) -> bool:
    return (
        right_index < 1
        or right_index >= len(ctx.eojeols)
        or ctx.eojeol_char_prefix[right_index] < 2
        or (ctx.char_len - ctx.eojeol_char_prefix[right_index]) < 3
    )


def _breaks_binary_phrase(
    ctx: SentenceContext,
    kind: str,
    left_index: int,
    right_index: int,
) -> bool:
    if kind == SERIAL_PARALLEL_3PLUS:
        return False
    left_text = ctx.eojeols[left_index].text
    right_text = ctx.eojeols[right_index].text
    if left_text.endswith(("와", "과")) and right_text != "그리고":
        return True
    if len(ctx.eojeols) == 3 and any("와" in eojeol.text or "과" in eojeol.text for eojeol in ctx.eojeols):
        return True
    return False


def _right_chunk_short(ctx: SentenceContext, right_index: int) -> bool:
    return (
        (ctx.char_len - ctx.eojeol_char_prefix[right_index]) < 6
        or (len(ctx.eojeols) - right_index) < 2
    )


def _is_frame_eojeol_normalized(normalized: str) -> bool:
    return normalized in _TIME_WORDS or normalized.endswith(_FRAME_JOSA) or normalized in _FRAME_WORDS


def _is_predicate_eojeol_normalized(normalized: str) -> bool:
    if normalized in _DEPENDENT_NOUNS:
        return False
    return normalized.endswith(("다", "요"))


def _is_number_word_normalized(normalized: str) -> bool:
    return bool(_KO_NUMBER_WORD_RE.fullmatch(normalized))


def _is_atomic_time_surface_normalized(normalized: str) -> bool:
    return bool(_ATOMIC_TIME_SURFACE_RE.fullmatch(normalized))


def _is_numeric_unit_surface_normalized(normalized: str) -> bool:
    if normalized in _TIME_WORDS or normalized in _EXPLICIT_SHIFT_WORDS:
        return False
    return bool(_NUMERIC_UNIT_RE.fullmatch(normalized))


def _is_numeric_like_normalized(normalized: str) -> bool:
    return (
        bool(_NUMBERISH_RE.search(normalized))
        or _is_number_word_normalized(normalized)
        or _is_atomic_time_surface_normalized(normalized)
        or _is_numeric_unit_surface_normalized(normalized)
        or bool(_EMERGENCY_SURFACE_RE.fullmatch(normalized))
    )


def _starts_path_like_normalized(normalized: str) -> bool:
    return bool(_URL_RE.match(normalized) or _PATH_RE.match(normalized) or "/" in normalized or "\\" in normalized)


def _is_natural_parallel_item_normalized(normalized: str) -> bool:
    if not normalized:
        return False
    if _is_numeric_like_normalized(normalized):
        return False
    if _starts_path_like_normalized(normalized):
        return False
    if _CODE_LIKE_RE.fullmatch(normalized) or _IP_RE.fullmatch(normalized):
        return False
    if _is_predicate_eojeol_normalized(normalized):
        return False
    return any(_is_hangul(ch) for ch in normalized)


def _normalize_surface(text: str) -> str:
    return _WHITESPACE_RE.sub("", text)


def _char_len_no_space(text: str) -> int:
    return len(_WHITESPACE_RE.sub("", text))


def _is_hangul(char: str) -> bool:
    code = ord(char)
    return (
        0xAC00 <= code <= 0xD7A3
        or 0x1100 <= code <= 0x11FF
        or 0x3130 <= code <= 0x318F
        or 0xA960 <= code <= 0xA97F
        or 0xD7B0 <= code <= 0xD7FF
    )
