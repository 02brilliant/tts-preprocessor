def run_default_compare_report(
    legacy_transform: Any | None = None,
    span_transform: Any | None = None,
    include_debug: bool = False,
    metadata: dict[str, Any] | None = None,
) -> CompareCorpusReport:
    corpus = build_default_compare_corpus()
    legacy_callable = legacy_transform
    if legacy_callable is None:
        legacy_callable = resolve_legacy_transform()
    if legacy_callable is None:
        legacy_callable = lambda text: None
    return run_compare_corpus(
        corpus,
        legacy_transform=legacy_callable,
        span_transform=span_transform,
        include_debug=include_debug,
        metadata=metadata,
    )


def write_compare_jsonl(report: CompareCorpusReport, path: str | Path) -> Path:
    target = Path(path)
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(export_compare_jsonl(report), encoding="utf-8")
    return target


def write_compare_markdown(
    report: CompareCorpusReport,
    path: str | Path,
    include_debug: bool = False,
) -> Path:
    target = Path(path)
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(
        export_compare_markdown(report, include_debug=include_debug),
        encoding="utf-8",
    )
    return target


def run_compare_corpus(
    entries: list[CompareCorpusEntry | dict[str, Any]],
    legacy_transform: Any | None = None,
    span_transform: Any | None = None,
    include_debug: bool = False,
    metadata: dict[str, Any] | None = None,
) -> CompareCorpusReport:
    normalized_entries = [_coerce_entry(entry) for entry in entries]
    legacy_callable = legacy_transform
    if legacy_callable is None:
        legacy_callable = get_optional_legacy_transform()

    if span_transform is None:
        from engine.span_engine.transform import transform as default_span_transform

        span_transform = default_span_transform

    results: list[CompareResult] = []
    for entry in normalized_entries:
        legacy_output: str | None = None
        span_output: str | None = None
        legacy_error: str | None = None
        span_error: str | None = None
        span_debug: dict[str, Any] | None = None

        if legacy_callable is not None:
            try:
                legacy_output = legacy_callable(entry.text)
            except Exception as exc:  # pragma: no cover - exercised by tests
                legacy_error = str(exc)

        try:
            span_output = span_transform(entry.text)
        except Exception as exc:  # pragma: no cover - exercised by tests
            span_error = str(exc)

        if include_debug and span_error is None:
            span_debug = build_span_debug(entry.text)

        result = _build_compare_result(
            entry=entry,
            legacy_output=legacy_output,
            span_output=span_output,
            legacy_error=legacy_error,
            span_error=span_error,
            span_debug=span_debug,
        )
        results.append(result)

    report = CompareCorpusReport(
        entries=normalized_entries,
        results=results,
        summary=build_compare_summary(results),
        metadata=dict(metadata or {}),
    )
    return report


def export_compare_jsonl(report: CompareCorpusReport) -> str:
    if not report.results:
        return ""
    return "\n".join(
        json.dumps(result.to_dict(), ensure_ascii=False)
        for result in report.results
    )


def export_compare_markdown(report: CompareCorpusReport, include_debug: bool = False) -> str:
    lines: list[str] = ["# Compare Report", ""]
    lines.extend(["## Summary", ""])
    lines.extend(_markdown_table(["category", "count"]))
    for category in _summary_category_order():
        lines.append(_markdown_table_row([category, str(report.summary.get(category, 0))]))
    lines.append(
        _markdown_table_row(
            ["by_category", _markdown_escape(json.dumps(report.summary.get("by_category", {}), ensure_ascii=False, sort_keys=True))]
        )
    )
    lines.append("")

    suspicious_rows: list[list[str]] = []
    intended_rows: list[list[str]] = []
    all_rows: list[list[str]] = []
    for entry, result in zip(report.entries, report.results):
        row = [
            entry.id,
            entry.text,
            result.legacy_output or "",
            result.span_output or "",
            result.category,
            result.reason,
        ]
        all_rows.append(row)
        if result.category == "suspicious_diff":
            suspicious_rows.append(row)
        elif result.category == "intended_v5_change":
            intended_rows.append(row)

    if suspicious_rows:
        lines.extend(["## Suspicious Diffs", ""])
        lines.extend(_markdown_table(["id", "input", "legacy", "span", "category", "reason"]))
        for row in suspicious_rows:
            lines.append(_markdown_table_row(row))
        lines.append("")

    if intended_rows:
        lines.extend(["## Intended V5 Changes", ""])
        lines.extend(_markdown_table(["id", "input", "legacy", "span", "category", "reason"]))
        for row in intended_rows:
            lines.append(_markdown_table_row(row))
        lines.append("")

    lines.extend(["## All Results", ""])
    lines.extend(_markdown_table(["id", "input", "legacy", "span", "category", "reason"]))
    for row in all_rows:
        lines.append(_markdown_table_row(row))

    if include_debug:
        debug_rows = [result.span_debug for result in report.results if result.span_debug is not None]
        if debug_rows:
            lines.extend(["", "## Debug", ""])
            for entry, result in zip(report.entries, report.results):
                if result.span_debug is None:
                    continue
                lines.extend(
                    [
                        f"### {entry.id}",
                        "",
                        "```json",
                        json.dumps(result.span_debug, ensure_ascii=False, sort_keys=True),
                        "```",
                        "",
                    ]
                )

    return "\n".join(lines).rstrip()


def build_compare_summary(results: list[CompareResult]) -> dict[str, Any]:
    by_category = {category: 0 for category in _summary_category_order()}
    counts = Counter(result.category for result in results)
    for category in by_category:
        by_category[category] = counts.get(category, 0)
    return {
        "total": len(results),
        "same": by_category["same"],
        "intended_v5_change": by_category["intended_v5_change"],
        "suspicious_diff": by_category["suspicious_diff"],
        "legacy_error_fixed": by_category["legacy_error_fixed"],
        "unsupported": by_category["unsupported"],
        "by_category": by_category,
        "suspicious_count": by_category["suspicious_diff"],
        "intended_count": by_category["intended_v5_change"],
    }


def _build_compare_result(
    entry: CompareCorpusEntry,
    legacy_output: str | None,
    span_output: str | None,
    legacy_error: str | None,
    span_error: str | None,
    span_debug: dict[str, Any] | None,
) -> CompareResult:
    if legacy_error and span_error:
        return CompareResult(
            input_text=entry.text,
            legacy_output=legacy_output,
            span_output=span_output,
            equal=False,
            category="unsupported",
            reason="both_errors",
            evidence={"entry_id": entry.id, "expected_category": entry.expected_category},
            span_debug=span_debug,
            legacy_error=legacy_error,
            span_error=span_error,
        )

    if span_error:
        return CompareResult(
            input_text=entry.text,
            legacy_output=legacy_output,
            span_output=span_output,
            equal=False,
            category="suspicious_diff",
            reason="span_error",
            evidence={"entry_id": entry.id, "expected_category": entry.expected_category, "error_side": "span"},
            span_debug=span_debug,
            legacy_error=legacy_error,
            span_error=span_error,
        )

    if legacy_error and span_output is not None:
        return CompareResult(
            input_text=entry.text,
            legacy_output=legacy_output,
            span_output=span_output,
            equal=False,
            category="legacy_error_fixed",
            reason="legacy_error",
            evidence={"entry_id": entry.id, "expected_category": entry.expected_category, "error_side": "legacy"},
            span_debug=span_debug,
            legacy_error=legacy_error,
            span_error=span_error,
        )

    result = classify_compare_result(
        input_text=entry.text,
        legacy_output=legacy_output,
        span_output=span_output,
        span_debug=span_debug,
        legacy_error=legacy_error,
        span_error=span_error,
    )
    result = _apply_expected_category_precedence(
        result=result,
        entry=entry,
        legacy_output=legacy_output,
        span_output=span_output,
    )
    result.evidence = dict(result.evidence)
    result.evidence.setdefault("entry_id", entry.id)
    result.evidence.setdefault("expected_category", entry.expected_category)
    if entry.expected_category is not None and entry.expected_category != result.category:
        result.evidence["expected_category_mismatch"] = True
    return result


def _coerce_entry(entry: CompareCorpusEntry | dict[str, Any]) -> CompareCorpusEntry:
    if isinstance(entry, CompareCorpusEntry):
        return entry
    return CompareCorpusEntry.from_dict(entry)


def _apply_expected_category_precedence(
    result: CompareResult,
    entry: CompareCorpusEntry,
    legacy_output: str | None,
    span_output: str | None,
) -> CompareResult:
    if entry.expected_category != "intended_v5_change":
        return result
    if result.category != "suspicious_diff":
        return result
    if span_output is None or result.span_error:
        return result
    if "intended_diff" not in entry.tags:
        return result

    intended_reason = _detect_entry_expected_intended_reason(
        entry=entry,
        legacy_output=legacy_output,
        span_output=span_output,
    )
    if intended_reason is None:
        return result

    evidence = dict(result.evidence)
    evidence.update(
        {
            "rule": intended_reason,
            "expected_category_override": True,
        }
    )
    if entry.id:
        evidence.setdefault("policy_case", entry.id)
    return CompareResult(
        input_text=result.input_text,
        legacy_output=result.legacy_output,
        span_output=result.span_output,
        equal=False,
        category="intended_v5_change",
        reason=intended_reason,
        evidence=evidence,
        span_debug=result.span_debug,
        legacy_error=result.legacy_error,
        span_error=result.span_error,
    )


def _detect_intended_reason(
    input_text: str,
    legacy_output: str | None,
    span_output: str | None,
) -> str | None:
    if _is_exact_square_bracket_unwrap(
        input_text=input_text,
        legacy_output=legacy_output,
        span_output=span_output,
    ):
        return "square_bracket_final_unwrap"

    if input_text in INTENDED_V5_CHANGE_INPUTS:
        return "policy_allowlist"

    if _is_legacy_bracket_internal_normalization_v5_protected_unwrap(
        input_text=input_text,
        legacy_output=legacy_output,
        span_output=span_output,
    ):
        return "legacy_bracket_internal_normalization_v5_protected_unwrap"

    if _is_supported_counter_reading(
        input_text=input_text,
        span_output=span_output,
    ):
        return "counter_native_reading"

    return None


def _detect_entry_expected_intended_reason(
    entry: CompareCorpusEntry,
    legacy_output: str | None,
    span_output: str | None,
) -> str | None:
    if _is_exact_square_bracket_unwrap(
        input_text=entry.text,
        legacy_output=legacy_output,
        span_output=span_output,
    ):
        return "square_bracket_final_unwrap"
    if _is_legacy_bracket_internal_normalization_v5_protected_unwrap(
        input_text=entry.text,
        legacy_output=legacy_output,
        span_output=span_output,
    ):
        return "legacy_bracket_internal_normalization_v5_protected_unwrap"
    if "counter" in entry.tags and _is_supported_counter_reading(entry.text, span_output):
        return "counter_native_reading"
    if entry.text in INTENDED_V5_CHANGE_INPUTS:
        return "policy_allowlist"
    return None


def _detect_suspicious_reason(
    input_text: str,
    legacy_output: str | None,
    span_output: str | None,
    span_debug: dict[str, Any] | None,
) -> str | None:
    if span_debug is not None:
        trace = span_debug.get("trace") or {}
        validation_logs = trace.get("validation_logs") or []
        if any(not log.get("passed", True) for log in validation_logs):
            return "shadow_validation_failed"

    if legacy_output is None or span_output is None:
        return None

    if legacy_output == span_output:
        return None

    if "[" in input_text or "(" in input_text:
        return "bracket_protection"

    if "http://" in input_text or "https://" in input_text or "/" in input_text:
        return "url_or_path_internal_change"

    if _has_literal_loss(legacy_output, span_output):
        return "changed_original_korean"

    if _shared_hangul(input_text, legacy_output, span_output):
        return "changed_original_korean"

    return None


def _is_exact_square_bracket_unwrap(
    input_text: str,
    legacy_output: str | None,
    span_output: str | None,
) -> bool:
    if legacy_output is None or span_output is None:
        return False
    if not input_text.startswith("[") or not input_text.endswith("]"):
        return False
    inner = input_text[1:-1]
    return legacy_output == input_text and span_output == inner


def _is_legacy_bracket_internal_normalization_v5_protected_unwrap(
    input_text: str,
    legacy_output: str | None,
    span_output: str | None,
) -> bool:
    if legacy_output is None or span_output is None:
        return False
    if not input_text.startswith("[") or not input_text.endswith("]"):
        return False
    inner = input_text[1:-1]
    if not inner:
        return False
    if span_output != inner:
        return False
    if legacy_output in {input_text, span_output}:
        return False
    if not any(ch.isdigit() for ch in inner):
        return False
    return any(_is_hangul(ch) for ch in legacy_output)


def _is_supported_counter_reading(input_text: str, span_output: str | None) -> bool:
    if span_output is None:
        return False
    if not re.fullmatch(r"\d+명", input_text):
        return False
    if not span_output.endswith(" 명"):
        return False
    number_part = span_output[:-2]
    if not number_part:
        return False
    return all(_is_hangul(ch) for ch in number_part)


def _has_literal_loss(legacy_output: str, span_output: str) -> bool:
    legacy_korean = "".join(ch for ch in legacy_output if _is_hangul(ch))
    span_korean = "".join(ch for ch in span_output if _is_hangul(ch))
    return bool(legacy_korean) and len(span_korean) < len(legacy_korean)


def _shared_hangul(input_text: str, legacy_output: str, span_output: str) -> bool:
    input_korean = {ch for ch in input_text if _is_hangul(ch)}
    if not input_korean:
        return False
    span_korean = {ch for ch in span_output if _is_hangul(ch)}
    legacy_korean = {ch for ch in legacy_output if _is_hangul(ch)}
    return bool(input_korean & span_korean) or bool(input_korean & legacy_korean)


def _is_hangul(ch: str) -> bool:
    code = ord(ch)
    return (
        0xAC00 <= code <= 0xD7A3
        or 0x3130 <= code <= 0x318F
        or 0x1100 <= code <= 0x11FF
    )


def _summary_category_order() -> tuple[str, ...]:
    return (
        "same",
        "intended_v5_change",
        "suspicious_diff",
        "legacy_error_fixed",
        "unsupported",
    )


def _markdown_table(headers: list[str]) -> list[str]:
    return [
        _markdown_table_row(headers),
        _markdown_table_row(["---" for _ in headers]),
    ]


def _markdown_table_row(values: list[str]) -> str:
    return "| " + " | ".join(_markdown_escape(value) for value in values) + " |"


def _markdown_escape(value: Any) -> str:
    if value is None:
        return ""
    text = str(value)
    return text.replace("|", "\\|").replace("\n", "<br>")


def _json_safe(value: Any) -> Any:
    if value is None or isinstance(value, (str, int, float, bool)):
        return value
    if isinstance(value, dict):
        return {str(key): _json_safe(item) for key, item in value.items()}
    if isinstance(value, list):
        return [_json_safe(item) for item in value]
    if isinstance(value, tuple):
        return [_json_safe(item) for item in value]
    if isinstance(value, CompareResult):
        return value.to_dict()
    if isinstance(value, CompareCorpusEntry):
        return value.to_dict()
    if isinstance(value, CompareCorpusReport):
        return value.to_dict()
    return value


__all__ = [
    "COMPARE_CATEGORIES",
    "INTENDED_V5_CHANGE_INPUTS",
    "CompareCorpusEntry",
    "CompareCorpusReport",
    "CompareResult",
    "build_compare_summary",
    "build_default_compare_corpus",
    "build_span_debug",
    "classify_compare_result",
    "export_compare_jsonl",
    "export_compare_markdown",
    "get_optional_legacy_transform",
    "resolve_legacy_transform",
    "run_default_compare_report",
    "run_compare_corpus",
    "write_compare_jsonl",
    "write_compare_markdown",
]
