from __future__ import annotations

import importlib
import json
import re
from collections import Counter
from dataclasses import asdict, dataclass, field
from pathlib import Path
from typing import Any

from engine.span_engine.trace import build_span_debug

COMPARE_CATEGORIES = frozenset(
    {
        "same",
        "intended_v5_change",
        "suspicious_diff",
        "legacy_error_fixed",
        "unsupported",
    }
)

INTENDED_V5_CHANGE_INPUTS = frozenset(
    {
        "AI",
        "FTA은",
        "3~8cm",
        "2025-01-03",
        "12.12 사태",
        "긴급번호 112는",
        "123-456-7890",
        "-2.5℃",
        "ㄱㄴㄷ",
        "3만",
        "90km/h",
        "60fps",
        "종로3가",
        "그리고 우리는 결과를 확인했다",
        "21명",
    }
)


@dataclass
class CompareResult:
    input_text: str
    legacy_output: str | None
    span_output: str | None
    equal: bool
    category: str
    reason: str
    evidence: dict[str, Any] = field(default_factory=dict)
    span_debug: dict[str, Any] | None = None
    legacy_error: str | None = None
    span_error: str | None = None

    def __post_init__(self) -> None:
        if not isinstance(self.input_text, str):
            raise TypeError("input_text must be str")
        if self.legacy_output is not None and not isinstance(self.legacy_output, str):
            raise TypeError("legacy_output must be str or None")
        if self.span_output is not None and not isinstance(self.span_output, str):
            raise TypeError("span_output must be str or None")
        if not isinstance(self.equal, bool):
            raise TypeError("equal must be bool")
        if self.category not in COMPARE_CATEGORIES:
            raise ValueError(f"invalid compare category: {self.category!r}")
        if not isinstance(self.reason, str):
            raise TypeError("reason must be str")
        if not isinstance(self.evidence, dict):
            raise TypeError("evidence must be dict")
        if self.span_debug is not None and not isinstance(self.span_debug, dict):
            raise TypeError("span_debug must be dict or None")
        if self.legacy_error is not None and not isinstance(self.legacy_error, str):
            raise TypeError("legacy_error must be str or None")
        if self.span_error is not None and not isinstance(self.span_error, str):
            raise TypeError("span_error must be str or None")
        if self.equal and self.category != "same":
            raise ValueError("equal=True requires category='same'")

    def to_dict(self) -> dict[str, Any]:
        return asdict(self)


@dataclass
class CompareCorpusEntry:
    id: str
    text: str
    tags: tuple[str, ...] = field(default_factory=tuple)
    expected_category: str | None = None
    metadata: dict[str, Any] = field(default_factory=dict)

    def __post_init__(self) -> None:
        if not isinstance(self.id, str) or not self.id.strip():
            raise ValueError("id must be a non-empty str")
        if not isinstance(self.text, str):
            raise TypeError("text must be str")
        self.tags = tuple(self.tags)
        if self.expected_category is not None and self.expected_category not in COMPARE_CATEGORIES:
            raise ValueError(f"invalid expected_category: {self.expected_category!r}")
        if not isinstance(self.metadata, dict):
            raise TypeError("metadata must be dict")
        self.metadata = dict(self.metadata)

    def to_dict(self) -> dict[str, Any]:
        return {
            "id": self.id,
            "text": self.text,
            "tags": list(self.tags),
            "expected_category": self.expected_category,
            "metadata": _json_safe(self.metadata),
        }

    @classmethod
    def from_dict(cls, data: dict[str, Any]) -> "CompareCorpusEntry":
        return cls(
            id=data["id"],
            text=data["text"],
            tags=tuple(data.get("tags", ())),
            expected_category=data.get("expected_category"),
            metadata=dict(data.get("metadata", {})),
        )


@dataclass
class CompareCorpusReport:
    entries: list[CompareCorpusEntry] = field(default_factory=list)
    results: list[CompareResult] = field(default_factory=list)
    summary: dict[str, Any] = field(default_factory=dict)
    metadata: dict[str, Any] = field(default_factory=dict)

    def __post_init__(self) -> None:
        self.entries = [
            entry if isinstance(entry, CompareCorpusEntry) else CompareCorpusEntry.from_dict(entry)
            for entry in self.entries
        ]
        self.results = [
            result if isinstance(result, CompareResult) else CompareResult(**result)
            for result in self.results
        ]
        if not isinstance(self.summary, dict):
            raise TypeError("summary must be dict")
        if not isinstance(self.metadata, dict):
            raise TypeError("metadata must be dict")
        self.summary = dict(self.summary)
        self.metadata = dict(self.metadata)

    def to_dict(self) -> dict[str, Any]:
        return {
            "entries": [entry.to_dict() for entry in self.entries],
            "results": [result.to_dict() for result in self.results],
            "summary": _json_safe(self.summary),
            "metadata": _json_safe(self.metadata),
        }

    @classmethod
    def from_dict(cls, data: dict[str, Any]) -> "CompareCorpusReport":
        return cls(
            entries=[CompareCorpusEntry.from_dict(item) for item in data.get("entries", [])],
            results=[CompareResult(**item) for item in data.get("results", [])],
            summary=dict(data.get("summary", {})),
            metadata=dict(data.get("metadata", {})),
        )


def classify_compare_result(
    input_text: str,
    legacy_output: str | None,
    span_output: str | None,
    span_debug: dict[str, Any] | None = None,
    legacy_error: str | None = None,
    span_error: str | None = None,
) -> CompareResult:
    if span_error:
        return CompareResult(
            input_text=input_text,
            legacy_output=legacy_output,
            span_output=span_output,
            equal=False,
            category="suspicious_diff",
            reason="span_error",
            evidence={"error_side": "span"},
            span_debug=span_debug,
            legacy_error=legacy_error,
            span_error=span_error,
        )

    if legacy_error and span_output is not None:
        return CompareResult(
            input_text=input_text,
            legacy_output=legacy_output,
            span_output=span_output,
            equal=False,
            category="legacy_error_fixed",
            reason="legacy_error",
            evidence={"error_side": "legacy"},
            span_debug=span_debug,
            legacy_error=legacy_error,
            span_error=span_error,
        )

    if legacy_output == span_output:
        return CompareResult(
            input_text=input_text,
            legacy_output=legacy_output,
            span_output=span_output,
            equal=True,
            category="same",
            reason="outputs_equal",
            evidence={},
            span_debug=span_debug,
            legacy_error=legacy_error,
            span_error=span_error,
        )

    intended_reason = _detect_intended_reason(
        input_text=input_text,
        legacy_output=legacy_output,
        span_output=span_output,
    )
    if intended_reason is not None:
        return CompareResult(
            input_text=input_text,
            legacy_output=legacy_output,
            span_output=span_output,
            equal=False,
            category="intended_v5_change",
            reason=intended_reason,
            evidence={
                "policy_case": input_text if input_text in INTENDED_V5_CHANGE_INPUTS else None,
                "rule": intended_reason,
            },
            span_debug=span_debug,
            legacy_error=legacy_error,
            span_error=span_error,
        )

    suspicious_reason = _detect_suspicious_reason(
        input_text=input_text,
        legacy_output=legacy_output,
        span_output=span_output,
        span_debug=span_debug,
    )
    if suspicious_reason is not None:
        return CompareResult(
            input_text=input_text,
            legacy_output=legacy_output,
            span_output=span_output,
            equal=False,
            category="suspicious_diff",
            reason=suspicious_reason,
            evidence={"rule": suspicious_reason},
            span_debug=span_debug,
            legacy_error=legacy_error,
            span_error=span_error,
        )

    return CompareResult(
        input_text=input_text,
        legacy_output=legacy_output,
        span_output=span_output,
        equal=False,
        category="unsupported",
        reason="unclassified_diff",
        evidence={},
        span_debug=span_debug,
        legacy_error=legacy_error,
        span_error=span_error,
    )


def get_optional_legacy_transform() -> Any:
    try:
        module = importlib.import_module("engine.pipeline.core")
    except Exception:
        return None
    return getattr(module, "normalize_text", None)


def resolve_legacy_transform() -> Any:
    return get_optional_legacy_transform()


