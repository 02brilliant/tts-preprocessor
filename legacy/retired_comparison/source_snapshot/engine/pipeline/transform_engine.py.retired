class HelperPhase(StrEnum):
    PRE_RULE = "pre_rule"
    RULE_PIPELINE = "rule_pipeline"
    RESTRICTED = "restricted_helper"
    POST_RULE_PROMOTION = "post_rule_promotion"
    PROSODY = "prosody"


@dataclass(frozen=True, slots=True)
class OwnedHelper:
    name: str
    helper_kind: HelperKind
    owner_stage: str
    phase: HelperPhase
    skip_hangul: bool = False


_ACTIVE_HELPER: contextvars.ContextVar[OwnedHelper | None] = contextvars.ContextVar(
    "tts_preprocessor_active_helper",
    default=None,
)


def _assert_owned_helper(
    helper_name: str,
    *,
    helper_kind: HelperKind | None = None,
    phase: HelperPhase | None = None,
) -> OwnedHelper:
    active_helper = _ACTIVE_HELPER.get()
    if active_helper is None or active_helper.name != helper_name:
        raise AssertionError(f"{helper_name} must run through the owned helper pipeline")
    if helper_kind is not None and active_helper.helper_kind != helper_kind:
        raise AssertionError(f"{helper_name} expected helper kind {helper_kind}, got {active_helper.helper_kind}")
    if phase is not None and active_helper.phase != phase:
        raise AssertionError(f"{helper_name} expected helper phase {phase}, got {active_helper.phase}")
    return active_helper


def _run_owned_helper(helper: OwnedHelper, runner):
    token = _ACTIVE_HELPER.set(helper)
    try:
        return runner()
    finally:
        _ACTIVE_HELPER.reset(token)


_COMMA_NUMBER_PATTERN = re.compile(
    r"\b\d{1,3}(,\d{3})+(\.\d+)?(?!,\d{3})(?=\b|[a-zA-Z가-힣])"
)
_D_NUMBER_PATTERN = re.compile(r"(?<![A-Za-z0-9가-힣])D-(?P<number>\d+)(?![A-Za-z0-9])")
_UPPER_HYPHEN_NUMBER_PATTERN = re.compile(
    r"(?<![A-Za-z0-9가-힣])(?P<acronym>[A-Z]{2,})-(?P<number>\d+)(?![A-Za-z0-9])"
)
_TWO_BLOCK_HYPHEN_KO_PATTERN = re.compile(
    r"(?<![A-Za-z0-9가-힣])(?<!\d-)(?P<left>\d+)-(?P<right>\d+)(?P<suffix>[가-힣]+)(?![A-Za-z0-9])"
)
_PROTECTED_D_NUMBER_PATTERN = re.compile(r"__protect_dnum__(?P<number>[a-j]+)__")
_PROTECTED_UPPER_HYPHEN_NUMBER_PATTERN = re.compile(
    r"__protect_uhn__(?P<acronym>[a-z]+)__(?P<number>[a-j]+)__"
)
_PROTECTED_TWO_BLOCK_HYPHEN_KO_PATTERN = re.compile(
    r"__protect_tbhk__(?P<left>[a-j]+)__(?P<right>[a-j]+)__(?P<suffix>[가-힣]+)__"
)
_PROTECTED_ENGLISH_WORD_NUMBER_PATTERN = re.compile(r"__protect_ewn__(?P<index>[a-j]+)__")
_PROTECTED_SPACED_DOT_NUMBER_PATTERN = re.compile(r"__protect_sdn__(?P<index>[a-j]+)__")
_PROTECTED_GUARDED_MIDDLE_DOT_PATTERN = re.compile(r"__protect_gmd__(?P<index>[a-j]+)__")
_ENGLISH_WORD_NUMBER_PATTERN = re.compile(
    r"(?<![A-Za-z0-9가-힣])(?P<word>[A-Za-z]+)\s+(?P<number>\d+(?:,\d{3})*(?:\.\d+)?)(?![A-Za-z0-9가-힣])"
)
_SPACED_DOT_NUMBER_PATTERN = re.compile(
    r"(?<![A-Za-z0-9가-힣])(?P<expr>\d+\s*\.\s+\d+|\d+\s+\.\s*\d+)(?![A-Za-z0-9가-힣])"
)
_GUARDED_MIDDLE_DOT_PATTERN = re.compile(
    r"(?<![A-Za-z0-9가-힣])(?P<expr>\d+·\s+\d+|\d+\s+·\d+)(?![A-Za-z0-9가-힣])"
)
_MIXED_TOKEN_TRAILING_PARTICLE_PATTERN = r"(?:으로|에서|에게|한테|이랑|까지|부터|은|는|이|가|을|를|와|과|의|에|로|만|도|란|뿐|고|다)?"
_LEXICAL_MIDDLE_DOT_PATTERN = re.compile(
    rf"(?<![A-Za-z0-9가-힣])(?P<left>[A-Z]{{2,}}|[가-힣]+)·(?P<right>[A-Z]{{2,}}|[가-힣]+?)(?P<particle>{_MIXED_TOKEN_TRAILING_PARTICLE_PATTERN})(?![A-Za-z0-9가-힣])"
)
_SINGLE_LETTER_HYPHEN_LEXICAL_PATTERN = re.compile(
    rf"(?<![A-Za-z0-9가-힣])(?P<left>[A-Za-z])-(?P<right>[A-Z]{{2,}}|[가-힣]+?)(?P<particle>{_MIXED_TOKEN_TRAILING_PARTICLE_PATTERN})(?![A-Za-z0-9가-힣])"
)
_WHITESPACE_RE = re.compile(r"\s+")
_ENGLISH_WORD_NUMBER_WHITELIST = {"USD", "KRW", "EUR", "pH", "Mach", "log"}
_SPACED_HYPHEN_DIGIT_BLOCK_PATTERN = re.compile(r"^\d{1,8}(?:\s+-\s+\d{1,8}){2,4}$")
_SINGLE_LETTER_HYPHEN_DIGIT_BLOCK_PATTERN = re.compile(r"^[A-Za-z]-\d{1,8}(?:-\d{1,8}){1,4}$")
_ACRONYM_PARTICLE_FORMS = ("으로", "은", "는", "이", "가", "을", "를", "와", "과", "로")
_ACRONYM_ATTACHED_PARTICLE_PATTERN = re.compile(
    rf"^(?P<acronym>[A-Z]{{2,}})(?P<particle>{'|'.join(_ACRONYM_PARTICLE_FORMS)})$"
)
_ACRONYM_WITH_LEXICAL_SUFFIX_PATTERN = re.compile(
    r"(?<![A-Za-z0-9가-힣])(?P<acronym>[A-Z]{2,})(?P<tail>[가-힣]+)(?![A-Za-z0-9가-힣])"
)
_EVENT_KEYWORD_PATTERN = r"(?:비상계엄|계엄|사태|혁명|민주화(?:\s*운동)?|전쟁|항쟁|운동|사건|정책|대책|사고|기념일|선거)"
_EVENT_MIDDLE_DOT_PATTERN = re.compile(
    rf"(?<![A-Za-z0-9가-힣])(?P<left>\d{{1,2}})·(?P<right>\d{{1,2}})(?P<space>\s*)(?P<keyword>{_EVENT_KEYWORD_PATTERN})(?P<particle>{_MIXED_TOKEN_TRAILING_PARTICLE_PATTERN})(?![A-Za-z0-9가-힣])"
)
_ORDINAL_MIXED_TOKEN_PATTERN = re.compile(
    rf"(?<![A-Za-z0-9가-힣])제(?P<number>\d+)(?P<suffix>차|회)(?P<particle>{_MIXED_TOKEN_TRAILING_PARTICLE_PATTERN})(?![A-Za-z0-9가-힣])"
)
_YEO_MIXED_TOKEN_PATTERN = re.compile(
    rf"(?<![A-Za-z0-9가-힣])(?P<number>(?:\d+\s*)+(?:만|천|백|십)?(?:\s*\d+(?:만|천|백|십)?)*|\d+)여\s+(?P<noun>명)(?P<particle>{_MIXED_TOKEN_TRAILING_PARTICLE_PATTERN})(?![A-Za-z0-9가-힣])"
)
_VERSUS_MIXED_TOKEN_PATTERN = re.compile(
    rf"(?<![A-Za-z0-9가-힣])(?P<left>\d+)대(?P<right>\d+)(?P<particle>{_MIXED_TOKEN_TRAILING_PARTICLE_PATTERN})(?![A-Za-z0-9가-힣])"
)
_SPACED_MIXED_NUMBER_COUNTER_PATTERN = re.compile(
    rf"(?<![A-Za-z0-9가-힣])(?P<number>\d+(?:만|천|백|십)(?:\s+\d+(?:만|천|백|십))*|\d+\s+\d+(?:천|백|십))\s+(?P<noun>개|명|권|장)(?P<particle>{_MIXED_TOKEN_TRAILING_PARTICLE_PATTERN})(?![A-Za-z0-9가-힣])"
)
_SPOKEN_RANGE_WITH_UNIT_PATTERN = re.compile(
    rf"(?<![A-Za-z0-9가-힣])(?P<start>\d+(?:,\d{{3}})*)에서\s+(?P<end>\S+?)(?P<particle>{_MIXED_TOKEN_TRAILING_PARTICLE_PATTERN})(?![A-Za-z0-9가-힣])"
)
_PAREN_BLOCK_RE = re.compile(r"\([^()]*\)")
_BRACKET_BLOCK_RE = re.compile(r"\[([^\[\]]*)\]")
_KOREAN_READING_CORE = r"[공영일이삼사오육칠팔구십백천만억조경해쩜한두세네다섯여섯일곱여덟아홉열스무스물서른마흔쉰예순일흔여든아흔]+"
_ALLOWED_PARTICLE_SUFFIX = r"(?:이라는|이고|이며|이다|이란|에는|으로|에서|에게|한테|이랑|까지|부터|은|는|이|가|을|를|와|과|의|에|로|만|도|란|뿐|고|다)?"
_LARGE_UNIT_SURFACE_PATTERN = re.compile(
    rf"(?<![가-힣])(?P<reading>{_KOREAN_READING_CORE}(?:억|조|경|해))(?P<particle>{_ALLOWED_PARTICLE_SUFFIX})(?![가-힣])"
)
_SIGNED_DEGREE_SURFACE_PATTERN = re.compile(
    rf"(?<![가-힣])(?P<reading>(?:화씨\s+)?(?:영하|마이너스)\s+{_KOREAN_READING_CORE}도)(?P<particle>{_ALLOWED_PARTICLE_SUFFIX})(?![가-힣])"
)
_RANGE_SURFACE_PATTERN = re.compile(
    rf"(?<![가-힣])(?P<reading>{_KOREAN_READING_CORE}에서\s+{_KOREAN_READING_CORE}(?:(?:월|일|년|도|개월)|(?:\s+(?:킬로그램|그램|센티미터|미터|리터|달러|유로|엔|파운드|위안|퍼센트|개|명|원|시|분|초)))?)(?P<particle>{_ALLOWED_PARTICLE_SUFFIX})(?![가-힣])"
)
_EVENT_SURFACE_PATTERN = re.compile(
    rf"(?<![가-힣])(?P<reading>{_KOREAN_READING_CORE})(?:\s+)(?P<keyword>(?:비상계엄|계엄|사태|혁명|민주화(?:\s+운동)?|전쟁|항쟁|운동|사건|정책|대책|사고|기념일|선거))(?P<particle>{_ALLOWED_PARTICLE_SUFFIX})(?![가-힣])"
)
def _apply_bracket_handling(text: str) -> str:
    # Conservative bracket policy: only well-formed flat pairs are handled.
    current = text
    while True:
        updated = _PAREN_BLOCK_RE.sub("", current)
        if updated == current:
            break
        current = updated
    while True:
        updated = _BRACKET_BLOCK_RE.sub(r"\1", current)
        if updated == current:
            break
        current = updated
    return current


def _cleanup_spacing(text: str) -> str:
    return text.strip()


def normalize_comma_numbers(text: str) -> str:
    def _replace(match: re.Match[str]) -> str:
        end = match.end()
        # Unsupported number/unit slash tails must stay atomic. Stripping the
        # comma here would mutate text that later policy stages are supposed to
        # preserve unchanged.
        if end < len(text) and text[end] == "/" and end + 1 < len(text) and text[end + 1].isalpha():
            return match.group(0)
        return match.group(0).replace(",", "")

    return _COMMA_NUMBER_PATTERN.sub(_replace, text)


def _normalize_snp_expression(text: str) -> str:
    def _replace(match: re.Match[str]) -> str:
        number_reading = read_integer_ko(match.group(1))
        return f"에스엔피 {number_reading}"

    return _SNP_EXPRESSION_PATTERN.sub(_replace, text)


def _read_event_number_surface(left_text: str, right_text: str) -> str:
    left_reading = read_integer_ko(left_text)
    if left_text == "12" and right_text == "12":
        right_reading = read_integer_ko(right_text)
    elif len(right_text) == 1:
        right_reading = read_integer_ko(right_text)
    else:
        right_reading = "".join(PHONE_DIGIT_KO[digit] for digit in right_text)
    return f"{left_reading}{right_reading}"


def _encode_protected_digits(text: str) -> str:
    return "".join(_PROTECTION_DIGIT_MAP[digit] for digit in text)


def _decode_protected_digits(text: str) -> str:
    return "".join(_PROTECTION_DIGIT_DECODE_MAP[char] for char in text)


def _protect_d_numbers_and_hyphen_triples(text: str) -> str:
    # D-number protection stays exactly as-is: its placeholder must survive
    # dictionary/rule/post-fix passes unchanged until the final restore step.
    # Plain numeric hyphen multi-block inputs are intentionally no longer
    # protected here because they are now handled later in the rules layer.
    current = _D_NUMBER_PATTERN.sub(
        lambda match: f"__protect_dnum__{_encode_protected_digits(match.group('number'))}__",
        text,
    )
    # Two-block numeric hyphen + Korean unit is protected due to ambiguity
    # (range/chapter/identifier). This prevents counter-noun adjustment from rewriting it.
    current = _TWO_BLOCK_HYPHEN_KO_PATTERN.sub(
        lambda match: (
            f"__protect_tbhk__{_encode_protected_digits(match.group('left'))}"
            f"__{_encode_protected_digits(match.group('right'))}"
            f"__{match.group('suffix')}__"
        ),
        current,
    )
    return _UPPER_HYPHEN_NUMBER_PATTERN.sub(
        lambda match: (
            f"__protect_uhn__{match.group('acronym').lower()}"
            f"__{_encode_protected_digits(match.group('number'))}__"
        ),
        current,
    )


def _restore_d_numbers_and_hyphen_triples(text: str) -> str:
    # Restore only the still-supported D-number / uppercase-hyphen placeholders.
    # Plain numeric hyphen multi-block inputs are no longer restored here
    # because they now stay visible to the rules layer end-to-end.
    current = _PROTECTED_D_NUMBER_PATTERN.sub(
        lambda match: f"D-{_decode_protected_digits(match.group('number'))}",
        text,
    )
    current = _PROTECTED_TWO_BLOCK_HYPHEN_KO_PATTERN.sub(
        lambda match: (
            f"{_decode_protected_digits(match.group('left'))}"
            f"-{_decode_protected_digits(match.group('right'))}"
            f"{match.group('suffix')}"
        ),
        current,
    )
    current = _PROTECTED_UPPER_HYPHEN_NUMBER_PATTERN.sub(
        lambda match: (
            f"{match.group('acronym').upper()}"
            f"-{_decode_protected_digits(match.group('number'))}"
        ),
        current,
    )
    return current


def _protect_english_word_number_phrases(text: str) -> tuple[str, dict[str, str]]:
    replacements: dict[str, str] = {}
    dictionary_surfaces = load_dictionary_entries()

    def _replace(match: re.Match[str]) -> str:
        end = match.end()
        if end < len(text) and text[end] == ":" and end + 1 < len(text) and text[end + 1].isdigit():
            return match.group(0)
        word = match.group("word")
        if word in _ENGLISH_WORD_NUMBER_WHITELIST or word in dictionary_surfaces:
            return match.group(0)

        key = f"__protect_ewn__{_encode_protected_digits(str(len(replacements)))}__"
        replacements[key] = match.group(0)
        return key

    return _ENGLISH_WORD_NUMBER_PATTERN.sub(_replace, text), replacements


def _restore_english_word_number_phrases(text: str, replacements: dict[str, str]) -> str:
    if not replacements:
        return text
    return _PROTECTED_ENGLISH_WORD_NUMBER_PATTERN.sub(
        lambda match: replacements.get(match.group(0), match.group(0)),
        text,
    )


def _protect_spaced_dot_numbers(text: str) -> tuple[str, dict[str, str]]:
    replacements: dict[str, str] = {}

    def _replace(match: re.Match[str]) -> str:
        expr = match.group("expr")
        key = f"__protect_sdn__{_encode_protected_digits(str(len(replacements)))}__"
        replacements[key] = expr
        return key

    return _SPACED_DOT_NUMBER_PATTERN.sub(_replace, text), replacements


def _restore_spaced_dot_numbers(text: str, replacements: dict[str, str]) -> str:
    if not replacements:
        return text
    return _PROTECTED_SPACED_DOT_NUMBER_PATTERN.sub(
        lambda match: replacements.get(match.group(0), match.group(0)),
        text,
    )


def _protect_guarded_middle_dot_numbers(text: str) -> tuple[str, dict[str, str]]:
    replacements: dict[str, str] = {}

    def _replace(match: re.Match[str]) -> str:
        expr = match.group("expr")
        key = f"__protect_gmd__{_encode_protected_digits(str(len(replacements)))}__"
        replacements[key] = expr
        return key

    return _GUARDED_MIDDLE_DOT_PATTERN.sub(_replace, text), replacements


def _restore_guarded_middle_dot_numbers(text: str, replacements: dict[str, str]) -> str:
    if not replacements:
        return text
    return _PROTECTED_GUARDED_MIDDLE_DOT_PATTERN.sub(
        lambda match: replacements.get(match.group(0), match.group(0)),
        text,
    )


# Letter-by-letter fallback readings for safe unknown ALL-CAPS acronyms.
# Dictionary-covered forms still take priority over this fallback map.
ALPHABET_MAP = {
    "A": "에이",
    "B": "비",
    "C": "씨",
    "D": "디",
    "E": "이",
    "F": "에프",
    "G": "지",
    "H": "에이치",
    "I": "아이",
    "J": "제이",
    "K": "케이",
    "L": "엘",
    "M": "엠",
    "N": "엔",
    "O": "오",
    "P": "피",
    "Q": "큐",
    "R": "알",
    "S": "에스",
    "T": "티",
    "U": "유",
    "V": "브이",
    "W": "더블유",
    "X": "엑스",
    "Y": "와이",
    "Z": "지",
}


def _is_safe_acronym_token(token_text: str) -> bool:
    # Intentionally narrow: only multi-letter ALL-CAPS alphabetic tokens.
    # Mixed, lower, alphanumeric, and hyphenated forms are excluded here.
    return (
        len(token_text) >= 2
        and token_text.isalpha()
        and token_text.isupper()
        and token_text not in SIMPLE_UNIT_MAP
    )


def _spell_out_acronym(token_text: str) -> str:
    # Compact fallback output, e.g. LLM -> 엘엘엠.
    return "".join(ALPHABET_MAP[char] for char in token_text)


def _resolve_acronym_reading(token_text: str) -> str:
    dictionary_reading = apply_dictionary(token_text)
    if dictionary_reading != token_text:
        return dictionary_reading
    return _spell_out_acronym(token_text)


def _split_supported_trailing_particle(text: str) -> tuple[str, str]:
    for particle in sorted(_SUPPORTED_PARTICLES, key=len, reverse=True):
        if text.endswith(particle) and len(text) > len(particle):
            return text[: -len(particle)], particle
    return text, ""


def _parse_mixed_digit_hangul_integer(text: str) -> int | None:
    compact = _WHITESPACE_RE.sub("", text)
    if not compact:
        return None

    multipliers = {"만": 10_000, "천": 1_000, "백": 100, "십": 10}
    total = 0
    index = 0

    while index < len(compact):
        match = re.match(r"(\d+)(만|천|백|십)?", compact[index:])
        if match is None or not match.group(0):
            return None
        number = int(match.group(1))
        unit = match.group(2)
        total += number * multipliers[unit] if unit else number
        index += len(match.group(0))

    return total


def _read_supported_unit_token(text: str) -> str | None:
    for parser in (
        try_parse_basic_unit,
        try_parse_filesize,
        try_parse_duration,
        try_parse_decimal_attached_unit,
    ):
        reading = parser(text)
        if reading is not None:
            return reading
    return None


def _protect_surface_value(
    registry: SurfaceRegistry,
    value: str,
    surface_type: SurfaceType,
    *,
    source_stage: str,
) -> str:
    return registry.register(
        surface_from_type(
            value,
            surface_type,
            source_stage=source_stage,
        )
    )


def _protect_surface_with_particle(
    registry: SurfaceRegistry,
    value: str,
    surface_type: SurfaceType,
    *,
    source_stage: str,
    particle: str = "",
    particle_surface_type: SurfaceType | None = None,
) -> str:
    surface = surface_from_type(
        value,
        surface_type,
        source_stage=source_stage,
    )
    if particle:
        surface = surface.attach_particle(particle, surface_type=particle_surface_type)
    return registry.register(surface)


def _protect_common_protected_literal_surfaces(text: str, registry: SurfaceRegistry) -> str:
    _assert_owned_helper(
        "_protect_common_protected_literal_surfaces",
        helper_kind=HelperKind.TYPED_SURFACE,
        phase=HelperPhase.PRE_RULE,
    )
    protected_spans = protected_literal_spans(text)
    if not protected_spans:
        return text

    pieces: list[str] = []
    cursor = 0
    for span in protected_spans:
        if span.start < cursor:
            continue
        pieces.append(text[cursor : span.start])
        pieces.append(
            _protect_surface_value(
                registry,
                text[span.start : span.end],
                SurfaceType.PROTECTED_LITERAL_SURFACE,
                source_stage="pre_rule.common_protected_literal",
            )
        )
        cursor = span.end
    pieces.append(text[cursor:])
    return "".join(pieces)


def _rewrite_plain_segments(
    text: str,
    registry: SurfaceRegistry,
    rewriter: callable[[str], str],
    *,
    helper: OwnedHelper,
    collision_log: list[str],
) -> str:
    policy = PlainSegmentPolicy(
        helper_name=helper.name,
        helper_kind=helper.helper_kind,
        owner_stage=helper.owner_stage,
        skip_hangul=helper.skip_hangul,
    )
    if "__surface__" not in text:
        if policy.skip_hangul and re.search(r"[가-힣]", text):
            collision_log.append(
                f"{policy.helper_name}: skipped Hangul plain segment under {policy.owner_stage}: {text!r}"
            )
            return text
        return rewriter(text)
    return registry.rewrite_plain_segments(
        text,
        rewriter,
        skip_hangul=policy.skip_hangul,
        policy=policy,
        collision_log=collision_log,
    )


def _read_protected_lexical_token(token_text: str) -> str | None:
    if re.fullmatch(r"[가-힣]+", token_text):
        return token_text
    if not token_text.isalpha():
        return None

    upper_token = token_text.upper()
    if len(upper_token) >= 2 and upper_token.isupper() and upper_token not in SIMPLE_UNIT_MAP:
        dictionary_reading = apply_dictionary(upper_token)
        if dictionary_reading != upper_token:
            return dictionary_reading
        return _spell_out_acronym(upper_token)
    return None


def _protect_lexical_middle_dot_compounds(text: str, registry: SurfaceRegistry) -> str:
    _assert_owned_helper(
        "_protect_lexical_middle_dot_compounds",
        helper_kind=HelperKind.TYPED_SURFACE,
        phase=HelperPhase.PRE_RULE,
    )

    def _replace(match: re.Match[str]) -> str:
        left_reading = _read_protected_lexical_token(match.group("left"))
        right_reading = _read_protected_lexical_token(match.group("right"))
        if left_reading is None or right_reading is None:
            return match.group(0)
        protected = _protect_surface_value(
            registry,
            f"{left_reading} {right_reading}",
            SurfaceType.LEXICAL_MIDDLEDOT_SURFACE,
            source_stage="normalization.lexical_middle_dot",
        )
        return f"{protected}{match.group('particle') or ''}"

    return _LEXICAL_MIDDLE_DOT_PATTERN.sub(_replace, text)


def _protect_single_letter_hyphen_lexical_compounds(text: str, registry: SurfaceRegistry) -> str:
    _assert_owned_helper(
        "_protect_single_letter_hyphen_lexical_compounds",
        helper_kind=HelperKind.TYPED_SURFACE,
        phase=HelperPhase.PRE_RULE,
    )

    def _replace(match: re.Match[str]) -> str:
        letter = match.group("left").upper()
        if letter not in ALPHABET_MAP:
            return match.group(0)
        protected = _protect_surface_value(
            registry,
            f"{ALPHABET_MAP[letter]}-{match.group('right')}",
            SurfaceType.SINGLE_LETTER_HYPHEN_SURFACE,
            source_stage="normalization.single_letter_hyphen",
        )
        return f"{protected}{match.group('particle') or ''}"

    return _SINGLE_LETTER_HYPHEN_LEXICAL_PATTERN.sub(_replace, text)


def _protect_event_middle_dot_surfaces(text: str, registry: SurfaceRegistry) -> str:
    _assert_owned_helper(
        "_protect_event_middle_dot_surfaces",
        helper_kind=HelperKind.TYPED_SURFACE,
        phase=HelperPhase.PRE_RULE,
    )

    def _replace(match: re.Match[str]) -> str:
        keyword = _WHITESPACE_RE.sub(" ", match.group("keyword").strip())
        decision = GATE_REGISTRY.evaluate(
            "event_keyword",
            candidate=match.group(0),
            text=text,
            start=match.start(),
            end=match.end(),
            left_text=match.group("left"),
            right_text=match.group("right"),
            keyword_text=keyword,
        )
        if not decision.allowed:
            return match.group(0)
        event_reading = _read_event_number_surface(match.group("left"), match.group("right"))
        return _protect_surface_with_particle(
            registry,
            f"{event_reading} {keyword}",
            SurfaceType.EVENT_SURFACE,
            source_stage="normalization.event_middle_dot",
            particle=match.group("particle") or "",
        )

    return _EVENT_MIDDLE_DOT_PATTERN.sub(_replace, text)


def _protect_acronym_with_lexical_suffix_surfaces(text: str, registry: SurfaceRegistry) -> str:
    _assert_owned_helper(
        "_protect_acronym_with_lexical_suffix_surfaces",
        helper_kind=HelperKind.TYPED_SURFACE,
        phase=HelperPhase.PRE_RULE,
    )

    def _replace(match: re.Match[str]) -> str:
        acronym = match.group("acronym")
        if not _is_safe_acronym_token(acronym):
            return match.group(0)

        tail = match.group("tail")
        if tail in _SUPPORTED_PARTICLES:
            return match.group(0)
        lexical_suffix, particle = _split_supported_trailing_particle(tail)
        if not lexical_suffix:
            return match.group(0)

        reading = _resolve_acronym_reading(acronym)
        return _protect_surface_with_particle(
            registry,
            f"{reading}{lexical_suffix}",
            SurfaceType.ACRONYM_WITH_LEXICAL_SUFFIX_SURFACE,
            source_stage="normalization.acronym_lexical_suffix",
            particle=particle,
        )

    return _ACRONYM_WITH_LEXICAL_SUFFIX_PATTERN.sub(_replace, text)


def _protect_numeric_prefixed_noun_surfaces(text: str, registry: SurfaceRegistry) -> str:
    _assert_owned_helper(
        "_protect_numeric_prefixed_noun_surfaces",
        helper_kind=HelperKind.TYPED_SURFACE,
        phase=HelperPhase.PRE_RULE,
    )

    current = _ORDINAL_MIXED_TOKEN_PATTERN.sub(
        lambda match: _protect_surface_with_particle(
            registry,
            f"제{read_integer_ko(match.group('number'))}{match.group('suffix')}",
            SurfaceType.NUMERIC_PREFIXED_NOUN_SURFACE,
            source_stage="normalization.numeric_prefixed_noun",
            particle=match.group("particle") or "",
        ),
        text,
    )

    def _replace_yeo(match: re.Match[str]) -> str:
        value = _parse_mixed_digit_hangul_integer(match.group("number"))
        if value is None:
            return match.group(0)
        particle = match.group("particle") or ""
        return _protect_surface_with_particle(
            registry,
            f"{read_integer_ko(str(value))}여 {match.group('noun')}",
            SurfaceType.NUMERIC_PREFIXED_NOUN_SURFACE,
            source_stage="normalization.numeric_prefixed_noun",
            particle=particle,
        )

    current = _YEO_MIXED_TOKEN_PATTERN.sub(_replace_yeo, current)

    current = _VERSUS_MIXED_TOKEN_PATTERN.sub(
        lambda match: _protect_surface_with_particle(
            registry,
            f"{read_integer_ko(match.group('left'))}대{read_integer_ko(match.group('right'))}",
            SurfaceType.NUMERIC_PREFIXED_NOUN_SURFACE,
            source_stage="normalization.numeric_prefixed_noun",
            particle=match.group("particle") or "",
        ),
        current,
    )

    def _replace_spaced_large_counter(match: re.Match[str]) -> str:
        value = _parse_mixed_digit_hangul_integer(match.group("number"))
        if value is None:
            return match.group(0)
        particle = match.group("particle") or ""
        return _protect_surface_with_particle(
            registry,
            f"{read_integer_ko(str(value))} {match.group('noun')}",
            SurfaceType.NUMERIC_PREFIXED_NOUN_SURFACE,
            source_stage="normalization.numeric_prefixed_noun",
            particle=particle,
        )

    return _SPACED_MIXED_NUMBER_COUNTER_PATTERN.sub(_replace_spaced_large_counter, current)


def _protect_range_with_unit_surfaces(text: str, registry: SurfaceRegistry) -> str:
    _assert_owned_helper(
        "_protect_range_with_unit_surfaces",
        helper_kind=HelperKind.TYPED_SURFACE,
        phase=HelperPhase.PRE_RULE,
    )

    def _replace(match: re.Match[str]) -> str:
        unit_reading = _read_supported_unit_token(match.group("end"))
        if unit_reading is None:
            return match.group(0)
        start_reading = read_integer_ko(match.group("start").replace(",", ""))
        return _protect_surface_with_particle(
            registry,
            f"{start_reading}에서 {unit_reading}",
            SurfaceType.RANGE_WITH_UNIT_SURFACE,
            source_stage="normalization.range_with_unit",
            particle=match.group("particle") or "",
        )

    return _SPOKEN_RANGE_WITH_UNIT_PATTERN.sub(_replace, text)


def _split_upper_acronym_numeric_suffixes(text: str) -> str:
    _assert_owned_helper(
        "_split_upper_acronym_numeric_suffixes",
        helper_kind=HelperKind.STRUCTURED_PARSER,
        phase=HelperPhase.PRE_RULE,
    )

    # Adjacent token sequences are allowed here: respecting token boundaries
    # does not mean acronym+number handling is limited to a single source token.
    def _replace(match: re.Match[str]) -> str:
        acronym = match.group("acronym")
        if acronym not in load_dictionary_entries():
            return match.group(0)
        suffix = match.group("suffix")
        if suffix:
            return f"{acronym} {match.group('number')} {suffix}"
        return f"{acronym} {match.group('number')}"

    current = _ACRONYM_NUMERIC_LABEL_PATTERN.sub(_replace, text)
    return _ACRONYM_NUMERIC_SUFFIX_PATTERN.sub(_replace, current)


def _apply_safe_acronym_fallback(source_text: str, transformed_text: str) -> str:
    source_tokens = tokenize(source_text)
    transformed_tokens = tokenize(transformed_text)
    if len(source_tokens) != len(transformed_tokens):
        return transformed_text

    dictionary_surfaces = load_dictionary_entries()
    parts: list[str] = []

    for i, (source_token, transformed_token) in enumerate(zip(source_tokens, transformed_tokens)):
        if not _is_safe_acronym_token(source_token.text):
            parts.append(transformed_token.text)
            continue
        if source_token.text in dictionary_surfaces:
            parts.append(transformed_token.text)
            continue
        if source_token.kind != token_types.WORD_EN_UPPER:
            parts.append(transformed_token.text)
            continue
        if transformed_token.text != "".join(ALPHABET_MAP[char] for char in source_token.text):
            parts.append(transformed_token.text)
            continue

        prev_non_space = None
        for j in range(i - 1, -1, -1):
            if not source_tokens[j].text.isspace():
                prev_non_space = source_tokens[j]
                break

        next_non_space = None
        for j in range(i + 1, len(source_tokens)):
            if not source_tokens[j].text.isspace():
                next_non_space = source_tokens[j]
                break

        if (
            (
                prev_non_space is not None
                and prev_non_space.kind in {token_types.PUNCT, token_types.SYMBOL, token_types.NUMBER, token_types.MIXED}
            )
            or (
                next_non_space is not None
                and next_non_space.kind in {token_types.PUNCT, token_types.SYMBOL, token_types.NUMBER, token_types.MIXED}
            )
        ):
            if (
                (prev_non_space is not None and prev_non_space.text == "-")
                or (next_non_space is not None and next_non_space.text == "-")
            ):
                parts.append(source_token.text)
                continue
            parts.append(transformed_token.text)
            continue

        parts.append(_spell_out_acronym(source_token.text))

    return "".join(parts)


def _protect_acronym_outputs(
    source_text: str,
    transformed_text: str,
    registry: SurfaceRegistry,
) -> str:
    _assert_owned_helper(
        "_protect_acronym_outputs",
        helper_kind=HelperKind.TYPED_SURFACE,
        phase=HelperPhase.PRE_RULE,
    )

    source_tokens = tokenize(source_text)
    transformed_tokens = tokenize(transformed_text)
    if len(source_tokens) != len(transformed_tokens):
        return transformed_text
    parts: list[str] = []

    for source_token, transformed_token in zip(source_tokens, transformed_tokens):
        protected_surface = None
        protected_type = SurfaceType.ACRONYM_SURFACE

        if source_token.kind == token_types.WORD_EN_UPPER and _is_safe_acronym_token(source_token.text):
            if source_token.text in {"USD", "KRW", "EUR", "JPY", "GBP"}:
                parts.append(transformed_token.text)
                continue

            reading = _resolve_acronym_reading(source_token.text)
            if transformed_token.text not in {reading, source_token.text}:
                parts.append(transformed_token.text)
                continue
            if transformed_token.text == source_token.text:
                parts.append(transformed_token.text)
                continue
            protected_surface = reading
        elif source_token.kind == token_types.MIXED:
            attached_particle_match = _ACRONYM_ATTACHED_PARTICLE_PATTERN.fullmatch(source_token.text)
            if attached_particle_match is None:
                parts.append(transformed_token.text)
                continue

            acronym = attached_particle_match.group("acronym")
            if not _is_safe_acronym_token(acronym) or acronym in {"USD", "KRW", "EUR", "JPY", "GBP"}:
                parts.append(transformed_token.text)
                continue

            reading = _resolve_acronym_reading(acronym)
            particle = attached_particle_match.group("particle")
            parts.append(
                _protect_surface_with_particle(
                    registry,
                    reading,
                    SurfaceType.ACRONYM_SURFACE,
                    source_stage="normalization.acronym",
                    particle=particle,
                    particle_surface_type=SurfaceType.ALLOWED_ACRONYM_WITH_PARTICLE,
                )
            )
            continue
        else:
            parts.append(transformed_token.text)
            continue

        parts.append(
            _protect_surface_value(
                registry,
                protected_surface,
                protected_type,
                source_stage="normalization.acronym",
            )
        )

    return "".join(parts)


_NUMERIC_JOSA_PATTERN = r"(?:이라는|이고|이며|이다|이란|에는|으로|에서|에게|한테|이랑|까지|부터|은|는|이|가|을|를|와|과|의|에|로|만|도|란|뿐|고|다)"
_ATTACHED_NUMBER_JOSA_PATTERN = r"(?:이라는|이고|이며|이다|이란|에는|으로|에서|에게|한테|이랑|까지|부터|은|는|이|가|을|를|와|과|의|에|로)"
_NUMBER_WORD_PATTERN = r"[공영일이삼사오육칠팔구십백천만억조경쩜]+"
_NUMBER_WORD_CHARS = "공영일이삼사오육칠팔구십백천만억조경"
_ACRONYM_NUMERIC_SUFFIX_PATTERN = re.compile(
    rf"(?<![A-Za-z0-9가-힣])(?P<acronym>[A-Z]+)(?P<number>\d+(?:\.\d+)?)(?P<suffix>{_NUMERIC_JOSA_PATTERN})?(?![A-Za-z0-9가-힣])"
)
_ACRONYM_NUMERIC_LABEL_PATTERN = re.compile(
    rf"(?<![A-Za-z0-9가-힣])(?P<acronym>[A-Z]+)\s*:\s*(?P<number>\d+)(?P<suffix>{_NUMERIC_JOSA_PATTERN})?(?![A-Za-z0-9가-힣])"
)
_RAW_DECIMAL_WITH_JOSA_PATTERN = re.compile(
    rf"(?<![A-Za-z0-9가-힣])(?P<number>\d+(?:,\d{{3}})*\.\d+)(?P<josa>{_NUMERIC_JOSA_PATTERN})(?![A-Za-z0-9가-힣])"
)
_RAW_COMPACT_DATE_SUFFIX_PATTERN = re.compile(
    rf"(?<![A-Za-z0-9가-힣])(?P<number>\d+(?:,\d{{3}})*)(?P<suffix>년|월|일)(?P<particle>{_ALLOWED_PARTICLE_SUFFIX})?(?![A-Za-z0-9가-힣])"
)
_NUMBER_READING_WITH_SPACED_JOSA_PATTERN = re.compile(
    rf"(?P<reading>[영일이삼사오육칠팔구십백천만억조경]+(?:쩜[영일이삼사오육칠팔구]+)?)\s+(?P<josa>{_NUMERIC_JOSA_PATTERN})(?![가-힣])"
)
_JOSA_NUMBER_WORD_SPACING_PATTERN = re.compile(
    rf"(?<=[가-힣])(?<![{_NUMBER_WORD_CHARS}])(?P<josa>{_ATTACHED_NUMBER_JOSA_PATTERN})(?P<number>{_NUMBER_WORD_PATTERN})(?=$|[\s,.!?])"
)
_DECIMAL_READING_SPACING_PATTERN = re.compile(
    r"쩜(?P<digits>[영일이삼사오육칠팔구](?:\s+[영일이삼사오육칠팔구])+)"
)
_RAW_INTEGER_DEGREE_PATTERN = re.compile(
    r"(?<![A-Za-z0-9가-힣])(?P<number>\d{1,3})도(?![A-Za-z0-9가-힣])"
)
_NUMERIC_LABEL_SUFFIX_PATTERN = re.compile(
    r"(?P<reading>[영일이삼사오육칠팔구십백천만억조경]+(?:쩜[영일이삼사오육칠팔구]+)?)\s+(?P<suffix>[나라마바사아자차카타파하])(?![가-힣])"
)
_STANDALONE_JO_PATTERN = re.compile(
    rf"(?<![가-힣])조(?=\s+{_NUMBER_WORD_PATTERN}(?![가-힣]))"
)
_STANDALONE_EOK_PATTERN = re.compile(
    rf"(?<![{_NUMBER_WORD_CHARS}])억(?=\s+{_NUMBER_WORD_PATTERN}(?![가-힣]))"
)
_RAW_NUMBER_WITH_ENGLISH_UNIT_PATTERN = re.compile(
    rf"(?<![A-Za-z0-9가-힣])(?P<number>\d+(?:,\d{{3}})*(?:\.\d+)?)(?P<unit>Gbps|GHz|V|A)(?P<suffix>{_NUMERIC_JOSA_PATTERN})?(?![A-Za-z0-9가-힣])"
)
_SNP_EXPRESSION_PATTERN = re.compile(
    rf"(?<![A-Za-z0-9가-힣])(?:S&P|SNP)\s?(\d+)"
    rf"(?=(?:{_NUMERIC_JOSA_PATTERN})?(?![A-Za-z0-9가-힣]))"
)
_DECIMAL_FRACTIONAL_RE = re.compile(r"\d+\.(\d+)")
_ENGLISH_UNIT_READINGS = {
    "V": "볼트",
    "A": "암페어",
    "Gbps": "기가비피에스",
    "GHz": "기가헤르츠",
}
_COUNTER_NOUNS = set(POLICY_COUNTER_NOUNS)
_COMPACT_MONTH_READINGS = {read_integer_ko(str(value)) for value in range(1, 13)}
_COMPACT_DAY_READINGS = {read_integer_ko(str(value)) for value in range(1, 32)}
_SAFE_DIGIT_COUNTER_NOUNS = set(POLICY_COUNTER_NOUNS)
_SUPPORTED_PARTICLES = set(_ACRONYM_PARTICLE_FORMS)
_LIVE_COUNTER_ATTACHED_PARTICLES = _SUPPORTED_PARTICLES
_NATIVE_COUNTER_FORMS = {
    "일": "한",
    "이": "두",
    "삼": "세",
    "사": "네",
    "오": "다섯",
    "육": "여섯",
    "칠": "일곱",
    "팔": "여덟",
    "구": "아홉",
    "십": "열",
}
_PROTECTION_DIGIT_MAP = {
    "0": "a",
    "1": "b",
    "2": "c",
    "3": "d",
    "4": "e",
    "5": "f",
    "6": "g",
    "7": "h",
    "8": "i",
    "9": "j",
}
_PROTECTION_DIGIT_DECODE_MAP = {value: key for key, value in _PROTECTION_DIGIT_MAP.items()}


def _has_supported_fractional_length(text: str) -> bool:
    match = _DECIMAL_FRACTIONAL_RE.fullmatch(text)
    if not match:
        return False
    return 1 <= len(match.group(1)) <= 6


def _fix_numeric_postpositions(text: str) -> str:
    _assert_owned_helper(
        "_fix_numeric_postpositions",
        helper_kind=HelperKind.GENERIC_STRING,
        phase=HelperPhase.RESTRICTED,
    )

    def _prev_non_space(index: int) -> str:
        cursor = index - 1
        while cursor >= 0 and text[cursor].isspace():
            cursor -= 1
        return text[cursor] if cursor >= 0 else ""

    def _replace_raw_decimal(match: re.Match[str]) -> str:
        prev = _prev_non_space(match.start())
        if prev and (prev.isascii() and prev.isalpha() or prev.isdigit() or prev in "-.$€¥￥£₩"):
            return match.group(0)
        normalized = normalize_number_text(match.group("number"))
        if normalized is None or not _has_supported_fractional_length(normalized):
            return match.group(0)
        return f"{read_decimal_ko(normalized)}{match.group('josa')}"

    digit_readings = set("".join(PHONE_DIGIT_KO[digit] for digit in "0123456789"))

    def _replace_spaced_josa(match: re.Match[str]) -> str:
        if match.group("josa") == "도":
            return match.group(0)

        reading = match.group("reading")
        if match.group("josa") == "이" and reading in digit_readings:
            prefix = text[: match.start()].rstrip()
            if prefix:
                prev_token = prefix.rsplit(None, 1)[-1]
                if prev_token in digit_readings:
                    return match.group(0)
            suffix = text[match.end() :].lstrip()
            if suffix:
                next_token = suffix.split(None, 1)[0]
                if next_token in digit_readings:
                    return match.group(0)

        return f"{reading}{match.group('josa')}"

    current = _RAW_DECIMAL_WITH_JOSA_PATTERN.sub(_replace_raw_decimal, text)
    return _NUMBER_READING_WITH_SPACED_JOSA_PATTERN.sub(_replace_spaced_josa, current)


def _normalize_raw_compact_date_suffixes(text: str) -> str:
    _assert_owned_helper(
        "_normalize_raw_compact_date_suffixes",
        helper_kind=HelperKind.STRUCTURED_PARSER,
        phase=HelperPhase.PRE_RULE,
    )

    def _replace(match: re.Match[str]) -> str:
        normalized = normalize_number_text(match.group("number"))
        if normalized is None or "." in normalized:
            return match.group(0)
        particle = match.group("particle") or ""
        return f"{read_integer_ko(normalized)}{match.group('suffix')}{particle}"

    return _RAW_COMPACT_DATE_SUFFIX_PATTERN.sub(_replace, text)


def _fix_compact_date_counter_spacing(text: str) -> str:
    _assert_owned_helper(
        "_fix_compact_date_counter_spacing",
        helper_kind=HelperKind.GENERIC_STRING,
        phase=HelperPhase.RESTRICTED,
    )

    tokens = tokenize(text)
    parts: list[str] = []
    i = 0

    while i < len(tokens):
        current = tokens[i]
        space_token = tokens[i + 1] if i + 1 < len(tokens) else None
        suffix_token = tokens[i + 2] if i + 2 < len(tokens) else None

        if (
            current.kind == "WORD_KO"
            and re.fullmatch(_NUMBER_WORD_PATTERN, current.text)
            and space_token is not None
            and space_token.text.isspace()
            and suffix_token is not None
            and suffix_token.text in {"년", "월", "일"}
        ):
            if suffix_token.text == "월" and current.text not in _COMPACT_MONTH_READINGS:
                parts.append(current.text)
                i += 1
                continue
            if suffix_token.text == "일" and current.text not in _COMPACT_DAY_READINGS:
                parts.append(current.text)
                i += 1
                continue
            parts.append(f"{current.text}{suffix_token.text}")
            i += 3
            continue

        parts.append(current.text)
        i += 1

    return "".join(parts)


def _fix_josa_number_spacing(text: str) -> str:
    _assert_owned_helper(
        "_fix_josa_number_spacing",
        helper_kind=HelperKind.GENERIC_STRING,
        phase=HelperPhase.RESTRICTED,
    )
    return _JOSA_NUMBER_WORD_SPACING_PATTERN.sub(
        lambda match: f"{match.group('josa')} {match.group('number')}",
        text,
    )


def _fix_decimal_reading_spacing(text: str) -> str:
    _assert_owned_helper(
        "_fix_decimal_reading_spacing",
        helper_kind=HelperKind.GENERIC_STRING,
        phase=HelperPhase.RESTRICTED,
    )
    return _DECIMAL_READING_SPACING_PATTERN.sub(
        lambda match: "쩜" + match.group("digits").replace(" ", ""),
        text,
