def _fix_residual_integer_degrees(text: str) -> str:
    _assert_owned_helper(
        "_fix_residual_integer_degrees",
        helper_kind=HelperKind.GENERIC_STRING,
        phase=HelperPhase.RESTRICTED,
    )

    def _replace(match: re.Match[str]) -> str:
        return f"{read_integer_ko(match.group('number'))}도"

    return _RAW_INTEGER_DEGREE_PATTERN.sub(_replace, text)


def _fix_numeric_label_suffix_spacing(text: str) -> str:
    _assert_owned_helper(
        "_fix_numeric_label_suffix_spacing",
        helper_kind=HelperKind.GENERIC_STRING,
