def normalize_text(text: str) -> NormalizationResult:
    # Spaced numeric hyphen multi-block inputs are out of scope for the
    # compact rule path and must remain unchanged.
    if _SPACED_HYPHEN_DIGIT_BLOCK_PATTERN.fullmatch(text):
        return NormalizationResult(text, (), ())

    # Single-letter-prefixed hyphen multi-block forms such as A-1-2 are also
    # outside the pure numeric policy and should pass through unchanged.
    if _SINGLE_LETTER_HYPHEN_DIGIT_BLOCK_PATTERN.fullmatch(text):
        return NormalizationResult(text, (), ())

    registry = SurfaceRegistry()
    collisions: list[str] = []
    gate_logs: list[str] = []
    pre_rule_helpers = {helper.name: helper for helper in PRE_RULE_HELPERS}
    restricted_helpers = {helper.name: helper for helper in RESTRICTED_HELPERS}
    promotion_helpers = {helper.name: helper for helper in POST_RULE_PROMOTION_HELPERS}
    with gate_log_scope(gate_logs):
        current = _apply_bracket_handling(text)
        current = _cleanup_spacing(current)
        current = _normalize_snp_expression(current)
        current = _run_owned_helper(
            pre_rule_helpers["_protect_common_protected_literal_surfaces"],
            lambda: _protect_common_protected_literal_surfaces(current, registry),
        )
        current = _run_owned_helper(
            pre_rule_helpers["_protect_event_middle_dot_surfaces"],
            lambda: _protect_event_middle_dot_surfaces(current, registry),
        )
        current = _run_owned_helper(
            pre_rule_helpers["_protect_acronym_with_lexical_suffix_surfaces"],
            lambda: _protect_acronym_with_lexical_suffix_surfaces(current, registry),
        )
        current = _run_owned_helper(
            pre_rule_helpers["_protect_numeric_prefixed_noun_surfaces"],
            lambda: _protect_numeric_prefixed_noun_surfaces(current, registry),
        )
        current = _run_owned_helper(
            pre_rule_helpers["_protect_range_with_unit_surfaces"],
            lambda: _protect_range_with_unit_surfaces(current, registry),
        )
        current = _run_owned_helper(
            pre_rule_helpers["_protect_large_unit_numeric_surfaces"],
            lambda: _rewrite_plain_segments(
                current,
                registry,
                lambda segment: _protect_large_unit_numeric_surfaces(segment, registry),
                helper=pre_rule_helpers["_protect_large_unit_numeric_surfaces"],
                collision_log=collisions,
            ),
        )
        current = _run_owned_helper(
            pre_rule_helpers["_protect_lexical_middle_dot_compounds"],
            lambda: _protect_lexical_middle_dot_compounds(current, registry),
        )
        current = _run_owned_helper(
            pre_rule_helpers["_protect_single_letter_hyphen_lexical_compounds"],
            lambda: _protect_single_letter_hyphen_lexical_compounds(current, registry),
        )
        current = _protect_d_numbers_and_hyphen_triples(current)
        current, protected_guarded_middle_dot_numbers = _protect_guarded_middle_dot_numbers(current)
        current, protected_spaced_dot_numbers = _protect_spaced_dot_numbers(current)
        current, protected_english_number_phrases = _protect_english_word_number_phrases(current)
        current = _run_owned_helper(
            pre_rule_helpers["_normalize_raw_compact_date_suffixes"],
            lambda: _normalize_raw_compact_date_suffixes(current),
        )
        current = _run_owned_helper(
            pre_rule_helpers["_split_upper_acronym_numeric_suffixes"],
            lambda: _split_upper_acronym_numeric_suffixes(current),
        )
        pre_dictionary = current
        current = apply_dictionary(current)
        current = _apply_safe_acronym_fallback(pre_dictionary, current)
        current = _run_owned_helper(
            pre_rule_helpers["_protect_acronym_outputs"],
            lambda: _protect_acronym_outputs(pre_dictionary, current, registry),
        )
        current = _run_owned_helper(
            RULE_PIPELINE_HELPER,
            lambda: _rewrite_plain_segments(
                current,
                registry,
                lambda segment: apply_rules(segment, gate_logs),
                helper=RULE_PIPELINE_HELPER,
                collision_log=collisions,
            ),
        )
        current = _run_owned_helper(
            restricted_helpers["_adjust_number_noun_particles"],
            lambda: _rewrite_plain_segments(
                current,
                registry,
                _adjust_number_noun_particles,
                helper=restricted_helpers["_adjust_number_noun_particles"],
                collision_log=collisions,
            ),
        )
        current = _run_owned_helper(
            restricted_helpers["_fix_numeric_postpositions"],
            lambda: _rewrite_plain_segments(
                current,
                registry,
                _fix_numeric_postpositions,
                helper=restricted_helpers["_fix_numeric_postpositions"],
                collision_log=collisions,
            ),
        )
        current = _run_owned_helper(
            restricted_helpers["_fix_josa_number_spacing"],
            lambda: _rewrite_plain_segments(
                current,
                registry,
                _fix_josa_number_spacing,
                helper=restricted_helpers["_fix_josa_number_spacing"],
                collision_log=collisions,
            ),
        )
        current = _run_owned_helper(
            restricted_helpers["_fix_decimal_reading_spacing"],
            lambda: _rewrite_plain_segments(
                current,
                registry,
                _fix_decimal_reading_spacing,
                helper=restricted_helpers["_fix_decimal_reading_spacing"],
                collision_log=collisions,
            ),
        )
        current = _run_owned_helper(
            restricted_helpers["_fix_numeric_label_suffix_spacing"],
            lambda: _rewrite_plain_segments(
                current,
                registry,
                _fix_numeric_label_suffix_spacing,
                helper=restricted_helpers["_fix_numeric_label_suffix_spacing"],
                collision_log=collisions,
            ),
        )
        current = _run_owned_helper(
            restricted_helpers["_fix_residual_integer_degrees"],
            lambda: _rewrite_plain_segments(
                current,
                registry,
                _fix_residual_integer_degrees,
                helper=restricted_helpers["_fix_residual_integer_degrees"],
                collision_log=collisions,
            ),
        )
        current = _run_owned_helper(
            restricted_helpers["_fix_standalone_jo"],
            lambda: _rewrite_plain_segments(
                current,
                registry,
                _fix_standalone_jo,
                helper=restricted_helpers["_fix_standalone_jo"],
                collision_log=collisions,
            ),
        )
        current = _run_owned_helper(
            restricted_helpers["_fix_standalone_eok"],
            lambda: _rewrite_plain_segments(
                current,
                registry,
                _fix_standalone_eok,
                helper=restricted_helpers["_fix_standalone_eok"],
                collision_log=collisions,
            ),
        )
        current = _run_owned_helper(
            restricted_helpers["_fix_residual_english_units"],
            lambda: _rewrite_plain_segments(
                current,
                registry,
                _fix_residual_english_units,
                helper=restricted_helpers["_fix_residual_english_units"],
                collision_log=collisions,
            ),
        )
        current = _run_owned_helper(
            restricted_helpers["_fix_compact_date_counter_spacing"],
            lambda: _rewrite_plain_segments(
                current,
                registry,
                _fix_compact_date_counter_spacing,
                helper=restricted_helpers["_fix_compact_date_counter_spacing"],
                collision_log=collisions,
            ),
        )
        current = _run_owned_helper(
            PHONETIC_HELPER,
            lambda: _apply_phonetic_smoothing(current, registry, collisions),
        )
        current = _run_owned_helper(
            promotion_helpers["_protect_post_rule_surface_matches"],
            lambda: _rewrite_plain_segments(
                current,
                registry,
                lambda segment: _protect_post_rule_surface_matches(segment, registry),
                helper=promotion_helpers["_protect_post_rule_surface_matches"],
                collision_log=collisions,
            ),
        )
        current = _restore_guarded_middle_dot_numbers(current, protected_guarded_middle_dot_numbers)
        current = _restore_spaced_dot_numbers(current, protected_spaced_dot_numbers)
        current = _restore_english_word_number_phrases(current, protected_english_number_phrases)
        current = _cleanup_spacing(_restore_d_numbers_and_hyphen_triples(current))
        rendered = registry.render(current)
    return NormalizationResult(_cleanup_spacing(rendered.text), rendered.rendered_surfaces, tuple(collisions), tuple(gate_logs))


def transform_text(text: str) -> str:
    return normalize_text(text).text
