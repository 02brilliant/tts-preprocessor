def _fix_residual_english_units(text: str) -> str:
    _assert_owned_helper(
        "_fix_residual_english_units",
        helper_kind=HelperKind.GENERIC_STRING,
        phase=HelperPhase.RESTRICTED,
    )

    def _replace(match: re.Match[str]) -> str:
        normalized = normalize_number_text(match.group("number"))
        if normalized is None:
            return match.group(0)

        if "." in normalized:
            if not _has_supported_fractional_length(normalized):
                return match.group(0)
            number_reading = read_decimal_ko(normalized)
        else:
            number_reading = read_integer_ko(normalized)

        suffix = match.group("suffix") or ""
        return f"{number_reading} {_ENGLISH_UNIT_READINGS[match.group('unit')]}{suffix}"

    return _RAW_NUMBER_WITH_ENGLISH_UNIT_PATTERN.sub(_replace, text)


_TIME_NUMBER_READING = r"[영일이삼사오육칠팔구십백천만억조경한두세네다섯여섯일곱여덟아홉열스무스물서른마흔쉰예순일흔여든아흔]+"
_PHONETIC_SUFFIX_PATTERN = (
    r"(?:입니다|합니까|하고|하며|하면서|이라는|이고|이며|이다|이란|에는|으로|에서|에게|한테|이랑|까지|부터|은|는|이|가|을|를|와|과|의|에|로|만|도|란|뿐|고|다)*"
)
_TIME_BINDING_RE = re.compile(
    rf"(?<![가-힣])(?P<number>{_TIME_NUMBER_READING})\s+(?P<unit>시|분|초)(?P<suffix>{_PHONETIC_SUFFIX_PATTERN})"
)
_JOSA_BINDING_RE = re.compile(
    rf"(?<![가-힣])(?P<word>(?:원|달러|유로|엔|파운드|킬로미터|미터|헤르츠|기가헤르츠|메가헤르츠|볼트|암페어|제곱미터|세제곱미터))(?:\s+)(?P<suffix>{_PHONETIC_SUFFIX_PATTERN[:-1]})"
)
_ATTACHED_UNIT_BINDING_RE = re.compile(
    rf"(?<![가-힣])(?P<number>{_TIME_NUMBER_READING})\s+(?P<unit>도)(?P<suffix>{_PHONETIC_SUFFIX_PATTERN})"
)


def _is_supported_particle(text: str) -> bool:
    return text in _SUPPORTED_PARTICLES


def _native_counter_form(text: str) -> str | None:
    return _NATIVE_COUNTER_FORMS.get(text)


COUNTER_POLICY = COUNTER_POLICY_TABLE


def _adjust_number_noun_particles(text: str) -> str:
    _assert_owned_helper(
        "_adjust_number_noun_particles",
        helper_kind=HelperKind.STRUCTURED_PARSER,
        phase=HelperPhase.RESTRICTED,
    )

    tokens = tokenize(text)
    parts: list[str] = []
    i = 0

    while i < len(tokens):
        current = tokens[i]
        space_token = tokens[i + 1] if i + 1 < len(tokens) else None
        noun_particle_token = tokens[i + 2] if i + 2 < len(tokens) else None

        mixed_match_handled = False
        if current.kind == "MIXED":
            for noun in _SAFE_DIGIT_COUNTER_NOUNS:
                for particle in _LIVE_COUNTER_ATTACHED_PARTICLES:
                    suffix = f"{noun}{particle}"
                    if not current.text.endswith(suffix):
                        continue
                    number_text = current.text[: -len(suffix)]
                    decision = GATE_REGISTRY.evaluate(
                        "counter_policy",
                        candidate=current.text,
                        number_text=number_text,
                        counter=noun,
                    )
                    if not decision.allowed or not number_text.isdigit():
                        continue
                    value = int(number_text)
                    reading = read_counter_number_with_policy(value, noun)
                    if reading is None:
                        continue
                    parts.append(f"{format_counter_reading(reading, noun)}{particle}")
                    i += 1
                    mixed_match_handled = True
                    break
                if mixed_match_handled:
                    break
                if current.text.endswith(noun):
                    number_text = current.text[: -len(noun)]
                    decision = GATE_REGISTRY.evaluate(
                        "counter_policy",
                        candidate=current.text,
                        number_text=number_text,
                        counter=noun,
                    )
                    if not decision.allowed or not number_text.isdigit():
                        continue
                    value = int(number_text)
                    reading = read_counter_number_with_policy(value, noun)
                    if reading is None:
                        continue
                    parts.append(format_counter_reading(reading, noun))
                    i += 1
                    mixed_match_handled = True
                    break
        if mixed_match_handled:
            continue

        native_form = _native_counter_form(current.text)
        noun_text = None
        particle_text = ""
        if noun_particle_token is not None:
            for noun in _COUNTER_NOUNS:
                if noun in COUNTER_POLICY and noun_particle_token.text == noun:
                    noun_text = noun
                    particle_text = ""
                    break
                if noun_particle_token.text.startswith(noun):
                    suffix = noun_particle_token.text[len(noun):]
                    if _is_supported_particle(suffix):
                        noun_text = noun
                        particle_text = suffix
                        break

        if (
            native_form is not None
            and space_token is not None
            and noun_particle_token is not None
            and space_token.text.isspace()
            and noun_text is not None
        ):
            policy = resolve_counter_policy(noun_text)
            if policy is not None and policy.mode == "sino_only":
                parts.append(current.text)
                parts.append(space_token.text)
                parts.append(noun_text)
                if particle_text:
                    parts.append(particle_text)
                i += 3
                continue
            parts.append(native_form)
            parts.append(space_token.text)
            parts.append(noun_text)
            if particle_text:
                parts.append(particle_text)
            i += 3
            continue

        if (
            space_token is not None
            and noun_particle_token is not None
            and space_token.text.isspace()
            and noun_text in COUNTER_POLICY
        ):
            value = NATIVE_COUNTER_NUMBER_TO_VALUE.get(current.text)
            if value is not None and should_apply_counter_policy(value, noun_text):
                reading = read_counter_number_with_policy(value, noun_text)
                if reading is not None:
                    parts.append(format_counter_reading(reading, noun_text))
                    if particle_text:
                        parts.append(particle_text)
                    i += 3
                    continue

        parts.append(current.text)
        i += 1

    return "".join(parts)


_NUMERIC_CURRENCY_SURFACE_PATTERN = re.compile(
    rf"(?<![가-힣])(?P<head>{_KOREAN_READING_CORE})(?:\s+)(?P<noun>원|달러|유로|엔|파운드)(?P<particle>{_ALLOWED_PARTICLE_SUFFIX})(?![가-힣])"
)
_NUMERIC_UNIT_SURFACE_PATTERN = re.compile(
    rf"(?<![가-힣])(?P<head>{_KOREAN_READING_CORE})(?:\s+)(?P<noun>킬로그램|그램|센티미터|미터|리터|헤르츠|기가헤르츠|메가헤르츠|볼트|암페어)(?P<particle>{_ALLOWED_PARTICLE_SUFFIX})(?![가-힣])"
)
_COUNTER_SURFACE_PATTERN = re.compile(
    rf"(?<![가-힣])(?P<head>{_KOREAN_READING_CORE})(?:\s+)(?P<noun>개|명|사람|권|장|마리|그루|송이|잔|병|벌|켤레|그릇|공기|조각|자루|알|판|살|층|호|동|년|월|일|개월|학년|학기|회)(?P<particle>{_ALLOWED_PARTICLE_SUFFIX})(?![가-힣])(?!(?:\s+{_KOREAN_READING_CORE})(?=$|[\s,.!?]))"
)


def _protect_post_rule_surface_matches(text: str, registry: SurfaceRegistry) -> str:
    _assert_owned_helper(
        "_protect_post_rule_surface_matches",
        helper_kind=HelperKind.TYPED_SURFACE,
        phase=HelperPhase.POST_RULE_PROMOTION,
    )

    def _register_surface(
        match: re.Match[str],
        surface_type: SurfaceType,
        source_stage: str,
    ) -> str:
        particle = match.groupdict().get("particle") or ""
        return _protect_surface_with_particle(
            registry,
            match.group("reading"),
            surface_type,
            source_stage=source_stage,
            particle=particle,
        )

    current = _EVENT_SURFACE_PATTERN.sub(
        lambda match: _protect_surface_with_particle(
            registry,
            f"{match.group('reading')} {match.group('keyword')}",
            SurfaceType.EVENT_SURFACE,
            source_stage="normalization.event",
            particle=match.group("particle") or "",
        ),
        text,
    )
    current = _SIGNED_DEGREE_SURFACE_PATTERN.sub(
        lambda match: _register_surface(
            match,
            SurfaceType.SIGNED_DEGREE_SURFACE,
            "normalization.signed_degree",
        ),
        current,
    )
    current = _RANGE_SURFACE_PATTERN.sub(
        lambda match: _register_surface(
            match,
            SurfaceType.RANGE_SURFACE,
            "normalization.range",
        ),
        current,
    )
    current = _LARGE_UNIT_SURFACE_PATTERN.sub(
        lambda match: _register_surface(
            match,
            SurfaceType.LARGE_UNIT_ATOMIC_SURFACE,
            "normalization.large_unit",
        ),
        current,
    )

    def _protect_structured_match(match: re.Match[str], surface_type: SurfaceType) -> str:
        head = match.group("head")
        noun = match.group("noun")
        particle = match.group("particle") or ""
        surface = surface_from_type(
            f"{head} {noun}",
            surface_type,
            source_stage=f"normalization.{surface_type.value.lower()}",
        )
        if particle:
            surface = surface.attach_particle(particle)
        return registry.register(surface)

    current = _NUMERIC_CURRENCY_SURFACE_PATTERN.sub(
        lambda match: _protect_structured_match(match, SurfaceType.NUMERIC_CURRENCY_SURFACE),
        current,
    )
    current = _NUMERIC_UNIT_SURFACE_PATTERN.sub(
        lambda match: _protect_structured_match(match, SurfaceType.NUMERIC_UNIT_SURFACE),
        current,
    )
    current = _COUNTER_SURFACE_PATTERN.sub(
        lambda match: _protect_structured_match(match, SurfaceType.COUNTER_SURFACE),
        current,
    )
    return current


def _protect_large_unit_numeric_surfaces(text: str, registry: SurfaceRegistry) -> str:
    _assert_owned_helper(
        "_protect_large_unit_numeric_surfaces",
        helper_kind=HelperKind.TYPED_SURFACE,
        phase=HelperPhase.PRE_RULE,
    )
    if not any(unit in text for unit in ("만", "억", "조", "경")):
        return text

    protected_spans = protected_literal_spans(text)

    def _overlaps_protected(start: int, end: int) -> bool:
        return any(start < span.end and span.start < end for span in protected_spans)

    scanned_large_unit_candidates = scan_large_unit_candidates(text)
    protected_context_spans: set[tuple[int, int]] = set()
    for candidate in scanned_large_unit_candidates:
        span = candidate.core_span
        if not _overlaps_protected(span.start, span.end):
            continue
        protected_context_spans.add(_nonspace_bounds(text, span.start, span.end))

    candidates = []
    for protected_span in protected_spans:
        protected_text = text[protected_span.start : protected_span.end]
        if not scan_large_unit_candidates(protected_text):
            continue
        protected_context_spans.add((protected_span.start, protected_span.end))

    for start, end in _merge_span_bounds(protected_context_spans):
        candidates.append(
            SurfaceCandidate(
                core_span=SourceSpan(start, end),
                full_span=SourceSpan(start, end),
                owner="preserve",
                surface_type="PROTECTED_LITERAL_SURFACE",
                reason="protected_large_unit_numeric_surface_preserve",
            )
        )

    cursor = 0
    for candidate in scanned_large_unit_candidates:
        span = candidate.core_span
        if span.start < cursor:
            continue
        if _overlaps_protected(span.start, span.end):
            continue
        suffix_span = candidate.metadata.get("suffix_span")
        if (
            candidate.owner == "large_unit_atomic"
            and "." in text[span.start : span.end]
            and isinstance(suffix_span, SourceSpan)
            and text[suffix_span.start : suffix_span.end] != "억"
            and text[span.end :].lstrip(" ").startswith("원")
        ):
            continue
        candidates.append(candidate)
        cursor = span.end

    if not candidates:
        return text

    candidates.sort(key=lambda candidate: candidate.core_span.start)
    parts: list[str] = []
    cursor = 0
    for candidate in candidates:
        span = candidate.core_span
        parts.append(text[cursor:span.start])
        raw = text[span.start : span.end]
        if candidate.owner == "large_unit_atomic":
            reading = parse_large_unit_candidate(text, candidate)
            render_pieces = large_unit_render_pieces(text, candidate)
            if reading is None or render_pieces is None:
                parts.append(raw)
            else:
                surface_text = "".join(piece.text for piece in render_pieces)
                parts.append(
                    registry.register(
                        surface_from_type(
                            surface_text,
                            SurfaceType.LARGE_UNIT_ATOMIC_SURFACE,
                            source_stage="pre_rule.large_unit_numeric_surface",
                        )
                    )
                )
        elif candidate.owner == "preserve":
            parts.append(
                registry.register(
                    surface_from_type(
                        raw,
                        SurfaceType.PROTECTED_LITERAL_SURFACE,
                        source_stage="pre_rule.large_unit_numeric_preserve",
                    )
                )
            )
        else:
            parts.append(raw)
        cursor = span.end
    parts.append(text[cursor:])
    return "".join(parts)


def _nonspace_bounds(text: str, start: int, end: int) -> tuple[int, int]:
    left = start
    while left > 0 and not text[left - 1].isspace():
        left -= 1
    right = end
    while right < len(text) and not text[right].isspace():
        right += 1
    return left, right


def _merge_span_bounds(bounds: set[tuple[int, int]]) -> list[tuple[int, int]]:
    merged: list[tuple[int, int]] = []
    for start, end in sorted(bounds):
        if not merged or start > merged[-1][1]:
            merged.append((start, end))
            continue
        previous_start, previous_end = merged[-1]
        merged[-1] = (previous_start, max(previous_end, end))
    return merged


def _apply_phonetic_smoothing(text: str, registry: SurfaceRegistry, collision_log: list[str]) -> str:
    active_helper = _assert_owned_helper(
        "_apply_phonetic_smoothing",
        helper_kind=HelperKind.STRUCTURED_PARSER,
        phase=HelperPhase.RESTRICTED,
    )

    def _rewrite(segment_text: str) -> str:
        current = _TIME_BINDING_RE.sub(
            lambda match: f"{match.group('number')}{match.group('unit')}{match.group('suffix')}",
            segment_text,
        )
        current = _ATTACHED_UNIT_BINDING_RE.sub(
            lambda match: f"{match.group('number')}{match.group('unit')}{match.group('suffix')}",
            current,
        )
        current = _JOSA_BINDING_RE.sub(
            lambda match: f"{match.group('word')}{match.group('suffix')}",
            current,
        )
        return current

    return registry.rewrite_plain_segments(
        text,
        _rewrite,
        policy=PlainSegmentPolicy(
            helper_name=active_helper.name,
            helper_kind=active_helper.helper_kind,
            owner_stage=active_helper.owner_stage,
            skip_hangul=active_helper.skip_hangul,
        ),
        collision_log=collision_log,
    )


