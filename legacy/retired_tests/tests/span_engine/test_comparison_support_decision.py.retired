from __future__ import annotations

import pytest

import api.server as api_server
import engine.legacy_compare as legacy_compare


EXPECTED_COMPARISON_FACADE_EXPORTS = [
    "COMPARISON_ROLLOUT_MODES",
    "build_shadow_compare_payload",
    "normalize_comparison_mode",
    "run_comparison_rollout",
    "run_shadow_compare",
    "transform_for_comparison",
    "transform_with_comparison_rollout",
]


def test_comparison_facade_declares_minimal_public_surface() -> None:
    assert legacy_compare.__all__ == EXPECTED_COMPARISON_FACADE_EXPORTS


def test_comparison_facade_modes_remain_comparison_only() -> None:
    assert legacy_compare.COMPARISON_ROLLOUT_MODES == frozenset(
        {"legacy_default", "span_shadow_compare"}
    )
    assert (
        legacy_compare.transform_with_comparison_rollout(
            "AI",
            mode="legacy_default",
            legacy_transform=lambda text: f"legacy:{text}",
        )
        == "legacy:AI"
    )


def test_production_api_points_removed_rollout_users_to_comparison_facade() -> None:
    with pytest.raises(ValueError) as exc_info:
        api_server.transform_request_payload(
            {"text": "AI", "rollout_mode": "span_shadow_compare"}
        )

    assert str(exc_info.value) == (
        "rollout_mode is no longer supported by the production API; "
        "use engine.legacy_compare for comparison"
    )


def test_shadow_compare_keeps_structured_error_contract() -> None:
    def failing_legacy(_: str) -> str:
        raise RuntimeError("legacy boom")

    result = legacy_compare.run_shadow_compare(
        "AI는 유지된다",
        legacy_transform=failing_legacy,
        include_debug=True,
    )

    assert result["legacy_output"] is None
    assert result["legacy_error"] == "legacy boom"
    assert result["production_output"] is None
    assert result["span_output"] == "에이아이는 유지된다"
    assert result["shadow"] is True
