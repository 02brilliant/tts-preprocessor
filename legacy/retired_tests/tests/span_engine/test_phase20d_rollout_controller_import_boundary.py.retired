from __future__ import annotations

import importlib
import sys


def test_phase20d_canonical_adapter_does_not_force_legacy_pipeline_import() -> None:
    adapter = importlib.import_module("engine.span_engine.production_adapter")
    before = {name for name in sys.modules if name.startswith("engine.pipeline")}

    adapter.transform_for_production("AI")

    after = {name for name in sys.modules if name.startswith("engine.pipeline")}
    assert after == before

def test_phase20d_injected_comparison_does_not_force_legacy_pipeline_import() -> None:
    adapter = importlib.import_module("engine.legacy_compare")
    run_comparison_rollout = getattr(adapter, "run_comparison_rollout")
    before = {name for name in sys.modules if name.startswith("engine.pipeline")}

    run_comparison_rollout(
        "90km/h",
        mode="span_shadow_compare",
        legacy_transform=lambda text: text,
    )

    after = {name for name in sys.modules if name.startswith("engine.pipeline")}
    assert after == before
